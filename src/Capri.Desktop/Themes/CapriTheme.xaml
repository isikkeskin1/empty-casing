<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- CAPRI / NEON NOIR design system.
       Quiet graphite canvases allow the artist's magenta-green character art
       to lead. Bright colors signal focused action, not every surface. -->
  <SolidColorBrush x:Key="CapriBaseBrush" Color="#090E18"/>
  <SolidColorBrush x:Key="CapriPanelBrush" Color="#111927"/>
  <SolidColorBrush x:Key="CapriRaisedBrush" Color="#1A2535"/>
  <SolidColorBrush x:Key="CapriTrimBrush" Color="#344558"/>
  <SolidColorBrush x:Key="CapriYellowBrush" Color="#F8CF61"/>
  <SolidColorBrush x:Key="CapriCyanBrush" Color="#53E5DC"/>
  <SolidColorBrush x:Key="CapriPinkBrush" Color="#FF407E"/>
  <SolidColorBrush x:Key="CapriLimeBrush" Color="#A3FF7F"/>
  <SolidColorBrush x:Key="CapriTextBrush" Color="#F2F6FA"/>
  <SolidColorBrush x:Key="CapriMutedBrush" Color="#99AFC1"/>
  <LinearGradientBrush x:Key="CapriHeroBackground" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#312140" Offset="0"/>
    <GradientStop Color="#161827" Offset="0.50"/>
    <GradientStop Color="#102B37" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CapriWindowAtmosphere" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#131C2A" Offset="0"/>
    <GradientStop Color="#0A101B" Offset="0.54"/>
    <GradientStop Color="#0F1725" Offset="1"/>
  </LinearGradientBrush>

  <Style x:Key="CapriPanel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CapriPanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource CapriTrimBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="13"/>
    <Setter Property="Padding" Value="18"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style x:Key="CapriLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource CapriCyanBrush}"/>
    <Setter Property="FontFamily" Value="Consolas"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="CapriSubtext" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource CapriMutedBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="18"/>
  </Style>
  <Style x:Key="CapriInput" TargetType="TextBox">
    <Setter Property="Background" Value="#101C2A"/>
    <Setter Property="Foreground" Value="{StaticResource CapriTextBrush}"/>
    <Setter Property="CaretBrush" Value="{StaticResource CapriPinkBrush}"/>
    <Setter Property="BorderBrush" Value="#426076"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="13,11"/>
    <Setter Property="MinHeight" Value="42"/>
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource CapriPinkBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="CapriToggle" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource CapriTextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Margin" Value="0,0,16,14"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="CapriButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource CapriTextBrush}"/>
    <Setter Property="Background" Value="{StaticResource CapriRaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource CapriTrimBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="15,10"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Frame" CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"/>
            <ContentPresenter VerticalAlignment="Center"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              RecognizesAccessKey="True"
                              Margin="{TemplateBinding Padding}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource CapriPinkBrush}"/>
              <Setter TargetName="Frame" Property="Background" Value="#27364B"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="#453149"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource CapriCyanBrush}"/>
              <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.38"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CapriPrimaryButton" TargetType="Button"
         BasedOn="{StaticResource CapriButton}">
    <Setter Property="Background" Value="#85314E"/>
    <Setter Property="BorderBrush" Value="{StaticResource CapriPinkBrush}"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>
  <Style x:Key="CapriDangerButton" TargetType="Button"
         BasedOn="{StaticResource CapriButton}">
    <Setter Property="Background" Value="#432335"/>
    <Setter Property="BorderBrush" Value="#D86C87"/>
    <Setter Property="Foreground" Value="#FFD9E4"/>
  </Style>
  <!-- Slim navigation rails rather than five identical raised rectangles.
       Keyboard focus, hover and active states remain fully accessible. -->
  <Style x:Key="CapriNavButton" TargetType="Button">
    <Setter Property="Foreground" Value="#9DB0C6"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="MinHeight" Value="48"/>
    <Setter Property="Padding" Value="16,11"/>
    <Setter Property="Margin" Value="0,2,0,2"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="NavSurface" Background="{TemplateBinding Background}"
                    CornerRadius="10"/>
            <Border x:Name="ActiveRail" HorizontalAlignment="Left"
                    Width="3" Margin="0,11,0,11"
                    Background="{StaticResource CapriPinkBrush}" CornerRadius="2"
                    Visibility="Collapsed"/>
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="NavSurface" Property="Background" Value="#233149"/>
              <Setter Property="Foreground" Value="#F1F5FA"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="NavSurface" Property="BorderBrush" Value="#53E5DC"/>
              <Setter TargetName="NavSurface" Property="BorderThickness" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.38"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CapriNavActiveButton" TargetType="Button"
         BasedOn="{StaticResource CapriNavButton}">
    <Setter Property="Foreground" Value="#FFF2F6"/>
    <Setter Property="Background" Value="#40283F"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="NavSurface" Background="#38263D"
                    CornerRadius="10"/>
            <Border HorizontalAlignment="Left" Width="3"
                    Background="{StaticResource CapriPinkBrush}" Margin="0,10,0,10"
                    CornerRadius="2"/>
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="NavSurface" Property="Background" Value="#4D304F"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="NavSurface" Property="BorderBrush" Value="#53E5DC"/>
              <Setter TargetName="NavSurface" Property="BorderThickness" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>