<Window x:Class="Capri.Desktop.Windows.InputSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capri Desktop — Input Control Center" Width="675" Height="760"
        MinWidth="580" MinHeight="590" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CapriBaseBrush}" Foreground="#EBF4FA">
  <Window.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource CapriButton}">
      <Setter Property="Foreground" Value="#EBF4FA"/>
      <Setter Property="Background" Value="#253349"/>
      <Setter Property="BorderBrush" Value="#62768C"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource CapriInput}">
      <Setter Property="Foreground" Value="#F4F8FA"/>
      <Setter Property="Background" Value="#172437"/>
      <Setter Property="BorderBrush" Value="#526176"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="FontFamily" Value="Consolas"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#18263A"/>
      <Setter Property="Foreground" Value="#0C1423"/>
      <Setter Property="Padding" Value="8,5"/>
    </Style>
  </Window.Resources>
  <DockPanel Margin="23">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="CAPRI // INPUT CONTROL" FontSize="27" FontWeight="Bold"
                 FontFamily="Consolas" Foreground="{StaticResource CapriYellowBrush}"/>
      <TextBlock Text="Choose devices and shortcuts. Microphone monitoring is opt-in."
                 Foreground="#9DB8CD" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom">
      <TextBlock x:Name="StatusText" Foreground="#A9D5E5" TextWrapping="Wrap"
                 Margin="0,8,0,10" FontFamily="Consolas" FontSize="11"/>
      <DockPanel>
        <Button Content="STOP INPUTS" DockPanel.Dock="Left"
                Background="#682941" Click="StopInputs_Click"/>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                    HorizontalAlignment="Right">
          <Button Content="RESET KEYS" Click="Reset_Click" Margin="0,0,9,0"/>
          <Button Content="SAVE INPUT SETTINGS" Background="#A03464"
                  BorderBrush="#FF74AC" FontWeight="Bold" Click="Save_Click"/>
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Padding="14" Margin="0,0,0,12" Background="#131D2D"
                BorderThickness="1" BorderBrush="#30465E" CornerRadius="0,8,0,0">
          <StackPanel>
            <TextBlock Text="01  MICROPHONE INPUT" Foreground="#7FE2EF"
                       FontFamily="Consolas" FontWeight="Bold" Margin="0,0,0,10"/>
            <ComboBox x:Name="MicBox" Margin="0,0,0,10"/>
            <DockPanel>
              <Button x:Name="TestMicButton" Content="TEST 5 SECONDS"
                      DockPanel.Dock="Left" Click="TestMic_Click"/>
              <ProgressBar x:Name="MicLevel" Margin="12,6,0,6"
                           Minimum="0" Maximum="100" Height="18" Value="0"/>
            </DockPanel>
            <TextBlock Text="The test opens the selected microphone briefly, displays input level, then closes it. No audio is saved or sent to an AI provider. Listening must be off while testing."
                       Foreground="#8FA7B8" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/>
          </StackPanel>
        </Border>

        <Border Padding="14" Margin="0,0,0,12" Background="#131D2D"
                BorderThickness="1" BorderBrush="#30465E" CornerRadius="0,8,0,0">
          <StackPanel>
            <TextBlock Text="02  SPEAKER OUTPUT" Foreground="#7FE2EF"
                       FontFamily="Consolas" FontWeight="Bold" Margin="0,0,0,10"/>
            <ComboBox x:Name="SpeakerBox"/>
            <TextBlock Text="Device selection applies to Fish Audio MP3 playback. Windows built-in speech uses the Windows default output device."
                       Foreground="#8FA7B8" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <Border Padding="14" Margin="0,0,0,12" Background="#131D2D"
                BorderThickness="1" BorderBrush="#30465E" CornerRadius="0,8,0,0">
          <StackPanel>
            <TextBlock Text="03  GLOBAL KEYBOARD SHORTCUTS" Foreground="#7FE2EF"
                       FontFamily="Consolas" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="Click a field and press Ctrl+Alt or Ctrl+Shift plus a letter, F1–F12 or Space. No typing or keystrokes are recorded."
                       Foreground="#91A8BC" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="OPEN CHAT" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,8,8"/>
              <TextBox x:Name="OpenChatKey" Grid.Row="0" Grid.Column="1"
                       KeyDown="Shortcut_KeyDown" Margin="0,0,0,8" IsReadOnly="True"/>
              <TextBlock Text="TOGGLE VOICE LISTENING" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,8,8"/>
              <TextBox x:Name="ToggleMicKey" Grid.Row="1" Grid.Column="1"
                       KeyDown="Shortcut_KeyDown" Margin="0,0,0,8" IsReadOnly="True"/>
              <TextBlock Text="TALK ONCE (20s)" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,8,8"/>
              <TextBox x:Name="TalkOnceKey" Grid.Row="2" Grid.Column="1"
                       KeyDown="Shortcut_KeyDown" Margin="0,0,0,8" IsReadOnly="True"/>
              <TextBlock Text="MUTE / UNMUTE MIC" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,8,8"/>
              <TextBox x:Name="MuteMicKey" Grid.Row="3" Grid.Column="1"
                       KeyDown="Shortcut_KeyDown" Margin="0,0,0,8" IsReadOnly="True"/>
              <TextBlock Text="FOCUS TYPE BOX" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,8,8"/>
              <TextBox x:Name="FocusTypingKey" Grid.Row="4" Grid.Column="1"
                       KeyDown="Shortcut_KeyDown" Margin="0,0,0,8" IsReadOnly="True"/>
              <TextBlock Text="HIDE / SHOW CAPRI" Grid.Row="5" VerticalAlignment="Center" Margin="0,0,8,8"/>
              <TextBox x:Name="ToggleCompanionKey" Grid.Row="5" Grid.Column="1"
                       KeyDown="Shortcut_KeyDown" Margin="0,0,0,8" IsReadOnly="True"/>
              <TextBlock Text="BRING CAPRI HERE" Grid.Row="6" VerticalAlignment="Center" Margin="0,0,8,8"/>
              <TextBox x:Name="BringHereKey" Grid.Row="6" Grid.Column="1"
                       KeyDown="Shortcut_KeyDown" Margin="0,0,0,8" IsReadOnly="True"/>
              <TextBlock Text="INTERRUPT ACTIVE REPLY" Grid.Row="7" VerticalAlignment="Center" Margin="0,0,8,8"/>
              <TextBox x:Name="StopReplyKey" Grid.Row="7" Grid.Column="1"
                       KeyDown="Shortcut_KeyDown" Margin="0,0,0,8" IsReadOnly="True"/>
              <TextBlock Text="STOP ALL INPUTS" Grid.Row="8" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="StopVoiceKey" Grid.Row="8" Grid.Column="1"
                       KeyDown="Shortcut_KeyDown" IsReadOnly="True"/>
            </Grid>
            <CheckBox x:Name="FollowUpsCheck"
                      Content="Allow 20-second follow-up questions after saying Capri"
                      Margin="0,14,0,0" Foreground="#C7E2E9"/>
            <TextBlock Text="Follow-ups are OFF by default. Enable them only in private surroundings; conversations may otherwise pick up nearby speech."
                       Margin="21,3,0,0" Foreground="#8FA7B8" TextWrapping="Wrap" FontSize="11"/>
            <CheckBox x:Name="VoiceInterruptCheck"
                      Content="Allow 'Capri, stop' to interrupt spoken output"
                      Margin="0,12,0,0" Foreground="#C7E2E9"/>
            <TextBlock Text="Voice interruption is OFF by default because speaker audio can echo into microphones. When enabled, 'Capri, cancel that' can stop a reply, but ordinary overheard speech cannot issue commands. The INTERRUPT REPLY shortcut always works."
                       Margin="21,3,0,0" Foreground="#8FA7B8" TextWrapping="Wrap" FontSize="11"/>
            <CheckBox x:Name="OpenChatForVoiceCheck"
                      Content="Open the full chat window for spoken requests"
                      Margin="0,12,0,0" Foreground="#C7E2E9"/>
            <TextBlock Text="OFF by default: Capri stays on the desktop overlay instead of switching focus away from your game. If spoken replies are disabled, the chat opens to show the answer."
                       Margin="21,3,0,0" Foreground="#8FA7B8" TextWrapping="Wrap" FontSize="11"/>
            <CheckBox x:Name="PettingCheck" Content="React to gentle mouse rubs over Capri"
                      Margin="0,12,0,0" Foreground="#C7E2E9"/>
          </StackPanel>
        </Border>
        <TextBlock Text="Safety: Windows may reserve some combinations. If a shortcut is unavailable, Capri reports it rather than installing a global keyboard hook. STOP INPUTS shuts down screen watching, mic capture, desktop actions and speech."
                   Foreground="#91AEC2" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
