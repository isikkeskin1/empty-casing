<Window x:Class="Capri.Desktop.Windows.CallCompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capri — Voice Call Companion" Width="635" Height="745"
        MinWidth="550" MinHeight="590"
        Background="{StaticResource CapriBaseBrush}" Foreground="#E4F2FC"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource CapriButton}">
      <Setter Property="Background" Value="#26374C"/>
      <Setter Property="Foreground" Value="#E8F4FA"/>
      <Setter Property="BorderBrush" Value="#5A7B8D"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="0,0,9,0"/>
      <Setter Property="FontFamily" Value="Consolas"/>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="CAPRI // CALL COMPANION" Foreground="{StaticResource CapriYellowBrush}"
                 FontWeight="Bold" FontFamily="Consolas" FontSize="24"/>
      <TextBlock Text="Capri's voice + optional real mic goes to your virtual microphone; she listens to a separately selected Discord output device."
                 TextWrapping="Wrap" Foreground="#A7C4D1" Margin="0,8,0,14"/>
      <Border Background="#16263B" BorderBrush="#496F86"
              BorderThickness="1" Padding="14" CornerRadius="0,7,0,0">
        <StackPanel>
          <TextBlock Text="AUDIO ROUTING" Foreground="#80E1D0"
                     FontWeight="Bold" FontFamily="Consolas"/>
          <TextBlock Text="01 // HEAR YOUR CALL"
                     Foreground="#B4CCDA" FontWeight="Bold" Margin="0,9,0,5"/>
          <TextBlock Text="Select the same Windows output device that Discord uses for voices. A dedicated call-only output isolates other app audio better than default speakers."
                     Foreground="#91AEC5" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,7"/>
          <ComboBox x:Name="CallIncomingBox" Margin="0,0,0,12" Padding="8,6"
                    Background="#172B42" Foreground="#0E1525"/>
          <TextBlock Text="02 // SPEAK INTO DISCORD"
                     Foreground="#B4CCDA" FontWeight="Bold" Margin="0,0,0,5"/>
          <TextBlock Text="Capri call-only speaker: choose CABLE Input (the virtual playback side). Normal Capri speaker settings in INPUTS stay unchanged."
                     Foreground="#91AEC5" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"/>
          <ComboBox x:Name="CallOutgoingBox" Margin="0,0,0,10" Padding="8,6"
                    Background="#172B42" Foreground="#0E1525"/>
          <TextBlock x:Name="OutputDeviceText" Foreground="#B4CCDA"
                     TextWrapping="Wrap" Margin="0,0,0,7"/>
          <TextBlock Text="Discord Voice &amp; Video: set Input Device to CABLE Output (virtual recording) and Output Device to your selected call-listening speakers. Fish Audio voice is required. Capri restores her normal playback device when Call Mode stops."
                     Foreground="#92AEBF" TextWrapping="Wrap" FontSize="11"/>
          <CheckBox x:Name="IncludeRealMicCheck"
                    Content="Also transmit my real microphone alongside Capri's voice"
                    Margin="0,12,0,0" Foreground="#DBF5EF"/>
          <TextBlock Text="When enabled, Capri bridges your selected real microphone into the virtual cable, so your friends hear both you and Capri. This never starts until you press START CALL MODE. Headphones are recommended to prevent feedback."
                     Foreground="#91AEC5" TextWrapping="Wrap" FontSize="11" Margin="21,4,0,0"/>
          <WrapPanel Margin="0,12,0,0">
            <Button x:Name="TestVirtualButton" Content="TEST DISCORD MIC ROUTE"
                    Click="TestVirtual_Click"/>
            <Button Content="GET VIRTUAL CABLE" Click="GetVirtualCable_Click"/>
            <Button Content="OPEN INPUTS / DEVICES" Click="Inputs_Click"/>
          </WrapPanel>
          <TextBlock Text="Test sends two quiet tones to the selected CABLE Input only. Discord's CABLE Output microphone level meter should respond. It does not open your real microphone or use Fish credits."
                     Foreground="#91AEC5" TextWrapping="Wrap" FontSize="11"
                     Margin="0,7,0,0"/>
        </StackPanel>
      </Border>
      <Border Margin="0,13,0,0" BorderBrush="#7D5160" BorderThickness="1"
              Background="#291D2B" Padding="13" CornerRadius="0,7,0,0">
        <StackPanel>
          <TextBlock Text="CALL CONSENT" Foreground="#FFC8D5"
                     FontWeight="Bold" FontFamily="Consolas"/>
          <TextBlock Text="This listens to ALL audio sent to the chosen Windows speaker endpoint, potentially including other apps. Inform call participants and get permission. Only recognized speech addressed to Capri generates replies. Raw audio is processed locally and not recorded. Addressed text may reach your cloud brain; generated speech text goes to Fish Audio."
                     TextWrapping="Wrap" Margin="0,8,0,10" Foreground="#DBBDCC"/>
          <CheckBox x:Name="InformedCheck"
                    Content="I told call participants Capri is an AI and obtained permission to listen/respond."
                    Foreground="#F3D4DF"
                    Margin="0,0,0,2"/>
        </StackPanel>
      </Border>
      <WrapPanel Margin="0,17,0,9">
        <Button x:Name="StartButton" Content="START CALL MODE"
                Click="Start_Click" Background="#235F57"
                BorderBrush="#84DFBA"/>
        <Button x:Name="StopButton" Content="STOP CALL MODE"
                Click="Stop_Click" IsEnabled="False"
                Background="#802F47" BorderBrush="#E57495"/>
        <Button Content="OPEN DISCORD" Click="Discord_Click"/>
        <Button Content="TOGGLE MUTE" Click="DiscordMute_Click"/>
        <Button Content="TOGGLE DEAFEN" Click="DiscordDeafen_Click"/>
        <Button x:Name="DiscordPresenceButton" Content="DISCORD STATUS ON/OFF"
                Click="DiscordPresence_Click"/>
      </WrapPanel>
      <TextBlock x:Name="StatusText" Foreground="#9FE4CF"
                 FontSize="12" TextWrapping="Wrap"
                 Text="Call Mode OFF. Join the voice call in the call app, then enable this mode."/>
      <TextBlock Text="Capri does not join Discord channels or use user tokens. You join normally and route audio through a virtual cable. The output loopback is device-wide, not Discord-process-only; preferably route Discord alone to that device. STOP CALL MODE or STOP ALL closes both incoming capture and any real-mic bridge."
                 Foreground="#8BA6B6" FontSize="11" TextWrapping="Wrap"
                 Margin="0,16,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>