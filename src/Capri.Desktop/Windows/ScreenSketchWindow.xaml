<Window x:Class="Capri.Desktop.Windows.ScreenSketchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capri // Screen Sketch" WindowStyle="None"
        AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="#01000000"
        WindowStartupLocation="Manual" KeyDown="Window_KeyDown">
    <Grid Background="#01000000">
        <!-- InkCanvas is intentionally interactive ONLY while explicit drawing
             mode is open; Escape and STOP ALL close it and restore normal input. -->
        <InkCanvas x:Name="SketchCanvas" Background="#01000000"
                   EditingMode="Ink"/>
        <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                Margin="20,20,0,0" Padding="11"
                Background="#F30A111B" BorderBrush="#F2D83D"
                BorderThickness="2" CornerRadius="0,12,0,0"
                Panel.ZIndex="5">
            <StackPanel>
                <DockPanel Margin="3,0,0,11">
                    <TextBlock Text="/// CAPRI  /  SCREEN SKETCH"
                               Foreground="#F2D83D"
                               FontFamily="Bahnschrift SemiCondensed"
                               FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="  ESC TO EXIT   •   3-MIN LIMIT"
                               Foreground="#2AF0E8" FontFamily="Consolas"
                               VerticalAlignment="Center" FontSize="10"
                               Margin="10,0,0,0"/>
                </DockPanel>
                <WrapPanel>
                    <Button Content="CYAN" Tag="cyan" Click="Color_Click"
                            Background="#16343D" Foreground="#2AF0E8"
                            BorderBrush="#2AF0E8" MinHeight="32" Padding="13,6"
                            Margin="0,0,8,0"/>
                    <Button Content="YELLOW" Tag="yellow" Click="Color_Click"
                            Background="#34311D" Foreground="#F2D83D"
                            BorderBrush="#F2D83D" MinHeight="32" Padding="13,6"
                            Margin="0,0,8,0"/>
                    <Button Content="PINK" Tag="pink" Click="Color_Click"
                            Background="#382037" Foreground="#FF4DA9"
                            BorderBrush="#FF4DA9" MinHeight="32" Padding="13,6"
                            Margin="0,0,8,0"/>
                    <Button Content="UNDO" Click="Undo_Click"
                            Background="#1D2C39" Foreground="#E9F2FF"
                            BorderBrush="#567B88" MinHeight="32" Padding="12,6"
                            Margin="0,0,8,0"/>
                    <Button Content="CLEAR" Click="Clear_Click"
                            Background="#1D2C39" Foreground="#E9F2FF"
                            BorderBrush="#567B88" MinHeight="32" Padding="12,6"
                            Margin="0,0,8,0"/>
                    <Button Content="SAVE PNG" Click="Save_Click"
                            Background="#1D2C39" Foreground="#E9F2FF"
                            BorderBrush="#567B88" MinHeight="32" Padding="12,6"
                            Margin="0,0,8,0"/>
                    <Button Content="EXIT  ✕" Click="Exit_Click"
                            Background="#543038" Foreground="#FFE4E4"
                            BorderBrush="#F27481" MinHeight="32" Padding="12,6"/>
                </WrapPanel>
                <TextBlock x:Name="SketchStatus"
                           Text="Draw with the mouse. Game clicks are paused until you EXIT."
                           Foreground="#A3C8D3" FontFamily="Consolas"
                           FontSize="10" Margin="3,9,0,1"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>