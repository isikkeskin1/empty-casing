<Window x:Class="Capri.Desktop.Windows.GameCoachHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capri // Game Coach HUD" Width="465" Height="255"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="NoResize"
        ShowActivated="False" Focusable="False" ShowInTaskbar="False"
        Topmost="True" AllowsTransparency="True" Background="Transparent">
    <Border Background="#F00A111A" BorderBrush="#F2D83D"
            BorderThickness="2" CornerRadius="0,15,0,0" Margin="7">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="17,14,17,11">
                <TextBlock Text="/// CAPRI" FontFamily="Bahnschrift SemiCondensed"
                           FontWeight="Bold" FontSize="23" Foreground="#F5DB41"/>
                <TextBlock DockPanel.Dock="Right" Text="GAME COACH  ·  VISUAL ESTIMATE"
                           FontFamily="Consolas" FontSize="10"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="#2AF0E8"/>
            </DockPanel>
            <TextBlock x:Name="TipText" Grid.Row="1"
                       Text="Waiting for game guidance..."
                       Margin="17,0,17,7" TextWrapping="Wrap"
                       Foreground="#EAF4FF" FontFamily="Segoe UI"
                       FontSize="14" LineHeight="21"
                       MaxHeight="155"
                       TextTrimming="CharacterEllipsis"/>
            <Border Grid.Row="2" Background="#14282F" BorderBrush="#2AF0E8"
                    BorderThickness="0,1,0,0" Padding="17,9" CornerRadius="0,0,0,0">
                <TextBlock Text="SCREENSHOT TIP  /  DISMISS VIA GAME CENTER OR STOP ALL"
                           Foreground="#87C9D1" FontFamily="Consolas" FontSize="10"/>
            </Border>
        </Grid>
    </Border>
</Window>