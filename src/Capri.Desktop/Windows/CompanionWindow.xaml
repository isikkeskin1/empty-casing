<Window x:Class="Capri.Desktop.Windows.CompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="270" Height="480" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" Title="Capri Desktop">
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem Header="Open chat" Click="OpenChat_Click"/>
      <Separator/>
      <MenuItem Header="Wake / idle" Click="Idle_Click"/>
      <MenuItem Header="Ride my cursor" Click="RideCursor_Click"/>
      <MenuItem Header="Hop off cursor" Click="HopOff_Click"/>
      <MenuItem Header="Chaos Mode — spawn 3 animated clones" Click="SpawnClones_Click"/>
      <MenuItem Header="Stop Chaos Mode" Click="StopClones_Click"/>
      <MenuItem Header="Size">
        <MenuItem Header="Tiny (50%)" Tag="0.5" Click="Scale_Click"/>
        <MenuItem Header="Small (75%)" Tag="0.75" Click="Scale_Click"/>
        <MenuItem Header="Normal (100%)" Tag="1" Click="Scale_Click"/>
        <MenuItem Header="Large (125%)" Tag="1.25" Click="Scale_Click"/>
        <MenuItem Header="Giant (160%)" Tag="1.6" Click="Scale_Click"/>
      </MenuItem>
      <MenuItem Header="Talk animation" Click="Talk_Click"/>
      <MenuItem Header="Glitch animation" Click="Glitch_Click"/>
      <MenuItem Header="Toss animation" Click="Toss_Click"/>
      <MenuItem Header="Sleep" Click="Sleep_Click"/>
      <MenuItem Header="Perch on frontmost window" Click="Attach_Click"/>
      <MenuItem Header="Detach from window" Click="Detach_Click"/>
      <MenuItem Header="Perch (animation preview)" Click="Perch_Click"/>
      <MenuItem Header="Music perch (preview)" Click="MusicPerch_Click"/>
      <Separator/>
      <MenuItem Header="Import animation pack ZIP…" Click="ImportArt_Click"/>
      <MenuItem Header="Open character art folder" Click="OpenArt_Click"/>
      <MenuItem Header="Reload character art" Click="ReloadArt_Click"/>
      <MenuItem Header="Hide Capri" Click="Hide_Click"/>
      <MenuItem Header="Quit Capri" Click="Quit_Click"/>
    </ContextMenu>
  </Window.ContextMenu>
  <Grid>
    <!-- Viewbox scales the entire existing animated stage as one unit. -->
    <Viewbox Stretch="Fill">
      <Canvas Width="270" Height="480">
      <Canvas x:Name="CharacterSurface" Width="270" Height="355" Canvas.Top="50"
              MouseLeftButtonDown="Character_MouseDown" MouseMove="Character_MouseMove"
              MouseLeave="Character_MouseLeave" Cursor="Hand" ToolTip="Drag or toss • Shift-drop to sit • Ctrl-drop to perch • Double-click to sleep or wake">
        <Canvas.RenderTransform>
          <TranslateTransform x:Name="FloatOffset"/>
        </Canvas.RenderTransform>
        <Grid x:Name="Placeholder" Width="224" Height="255" Canvas.Left="23" Canvas.Top="35">
          <Ellipse Width="192" Height="192" Stroke="#8966E8F4" StrokeThickness="1"
                   StrokeDashArray="3,8" Opacity="0.8"/>
          <Ellipse Width="154" Height="154" Stroke="#62DCEB" StrokeThickness="1.5">
            <Ellipse.Effect>
              <DropShadowEffect Color="#00D9E8" BlurRadius="28" ShadowDepth="0" Opacity="0.7"/>
            </Ellipse.Effect>
          </Ellipse>
          <Border Width="132" Height="132" CornerRadius="66" Background="#EF101829"
                  BorderBrush="#7569B3C8" BorderThickness="1">
            <Grid>
              <TextBlock Text="C" HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontFamily="Consolas" FontWeight="Bold" FontSize="85" Foreground="#AFF4FC"/>
              <TextBlock Text="ART SLOT" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Foreground="#FC93B5" FontFamily="Consolas" FontSize="9" Margin="0,0,0,10"/>
            </Grid>
          </Border>
          <TextBlock Text="RIGHT-CLICK → IMPORT ART ZIP" VerticalAlignment="Top" HorizontalAlignment="Center"
                     Foreground="#A0D7E6" FontFamily="Consolas" FontSize="9" Margin="0,7,0,0"/>
        </Grid>
        <Image x:Name="CharacterImage" Canvas.Left="15" Canvas.Top="6" Width="240" Height="348"
               Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Canvas>
      <!-- Angular, high-contrast conversation card modeled after the owner's
           reference clip: avatar tag, amber trim, cyan offset and a real CTA. -->
      <Grid x:Name="ReactionBubble" Canvas.Left="5" Canvas.Top="13" Width="260"
            MaxHeight="154" Visibility="Collapsed" Opacity="1">
        <Border Background="#F40A131F" BorderBrush="{StaticResource CapriYellowBrush}"
                BorderThickness="2" CornerRadius="0,8,0,0" Padding="9,8,9,9">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="25"/>
              </Grid.ColumnDefinitions>
              <Border Background="#482339" BorderBrush="{StaticResource CapriPinkBrush}"
                      BorderThickness="1" Width="29" Height="29" HorizontalAlignment="Left">
                <TextBlock Text="C" FontWeight="Bold" FontSize="21"
                           FontFamily="Bahnschrift SemiCondensed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource CapriCyanBrush}"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="/// CAPRI" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource CapriCyanBrush}"/>
                <TextBlock Text="DESKTOP COMPANION" FontFamily="Consolas" FontSize="8"
                           Foreground="{StaticResource CapriMutedBrush}"/>
              </StackPanel>
              <Button Grid.Column="2" Content="×" Click="DismissReaction_Click"
                      Width="24" Height="24" MinHeight="24" Padding="0"
                      Style="{StaticResource CapriButton}"
                      ToolTip="Dismiss this message"/>
            </Grid>
            <TextBlock x:Name="ReactionText" Foreground="{StaticResource CapriTextBrush}"
                       TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"
                       MaxHeight="60" Margin="1,0,1,9"/>
            <Button Content="TALK TO ME" Click="ReactionTalk_Click"
                    HorizontalAlignment="Left" Style="{StaticResource CapriPrimaryButton}"
                    MinHeight="27" FontSize="10" Padding="9,4"
                    ToolTip="Activate Talk Once, or open chat if the microphone is unavailable."/>
          </StackPanel>
        </Border>
        <Rectangle Fill="{StaticResource CapriCyanBrush}" Height="3" Width="115"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,8,0" IsHitTestVisible="False"/>
      </Grid>
      <Border Canvas.Left="35" Canvas.Top="409" Width="200" Height="30"
              Background="#F00B1723" BorderBrush="{StaticResource CapriCyanBrush}"
              BorderThickness="1" CornerRadius="0,6,0,0">
        <DockPanel VerticalAlignment="Center" Margin="12,0">
          <Ellipse x:Name="StatusLight" DockPanel.Dock="Left" Width="7" Height="7"
                   Fill="#7DEBD1" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock x:Name="StatusText" Text="CAPRI // IDLE"
                     Foreground="#D5EDF4" FontFamily="Consolas" FontSize="11"
                     VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      <Button Canvas.Left="73" Canvas.Top="446" Width="124" Height="28" MinHeight="28"
              Content="OPEN CHAT" ToolTip="Ctrl+Shift+Space" Click="OpenChat_Click"
              Style="{StaticResource CapriButton}" FontSize="10" Padding="7,4"/>
      </Canvas>
    </Viewbox>
  </Grid>
</Window>
