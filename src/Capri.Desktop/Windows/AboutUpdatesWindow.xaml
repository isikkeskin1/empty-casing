<Window x:Class="Capri.Desktop.Windows.AboutUpdatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capri // About &amp; Updates" Width="740" Height="690"
        MinWidth="590" MinHeight="550" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CapriBaseBrush}"
        Foreground="{StaticResource CapriTextBrush}"
        FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,17">
      <TextBlock Text="/// CAPRI  /  RELEASE CENTER"
                 Foreground="{StaticResource CapriYellowBrush}"
                 FontFamily="Bahnschrift SemiCondensed" FontWeight="Bold"
                 FontSize="26"/>
      <TextBlock Text="Check official GitHub releases, understand the installed build and create a privacy-conscious support report."
                 Margin="0,7,0,0" Foreground="{StaticResource CapriMutedBrush}"
                 TextWrapping="Wrap"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,8">
        <Border Style="{StaticResource CapriPanel}" Padding="16" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="/// INSTALLED BUILD" Style="{StaticResource CapriLabel}"/>
            <TextBlock x:Name="VersionText" Text="0.6.0"
                       Foreground="{StaticResource CapriCyanBrush}"
                       FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                       Margin="0,8,0,10"/>
            <TextBlock Text="Capri checks for new GitHub releases shortly after startup, then every 10 minutes. Installed copies can install verified updates automatically while idle or on exit, without disturbing active work."
                       Style="{StaticResource CapriSubtext}" TextWrapping="Wrap"
                       Margin="0,0,0,13"/>
            <CheckBox x:Name="AutoUpdateCheck"
                      Content="Automatically check and download verified updates"
                      Style="{StaticResource CapriToggle}"
                      Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed"
                      Margin="0,0,0,7"/>
            <CheckBox x:Name="AutoInstallCheck"
                      Content="Automatically install updates when safely idle or when I quit Capri"
                      Style="{StaticResource CapriToggle}"
                      Checked="AutoInstall_Changed" Unchecked="AutoInstall_Changed"
                      Margin="0,0,0,7"/>
            <TextBlock x:Name="AutoInstallExplanation"
                       Text="Automatic installation works with the standard per-user Capri installation. Portable builds require manual updating. Capri won't restart during an active conversation or game."
                       Style="{StaticResource CapriSubtext}" FontSize="11"
                       TextWrapping="Wrap" Margin="22,0,0,13"/>
            <WrapPanel>
              <Button x:Name="CheckButton" Content="CHECK FOR UPDATES"
                      Click="CheckUpdates_Click" Style="{StaticResource CapriPrimaryButton}"
                      Margin="0,0,9,9"/>
              <Button x:Name="RestartUpdateButton" Content="RESTART TO UPDATE"
                      IsEnabled="False" Click="RestartUpdate_Click"
                      Style="{StaticResource CapriPrimaryButton}" Margin="0,0,9,9"/>
              <Button x:Name="OpenReleaseButton" Content="OPEN OFFICIAL RELEASE"
                      IsEnabled="False" Click="OpenRelease_Click"
                      Style="{StaticResource CapriButton}" Margin="0,0,9,9"/>
              <Button Content="SEE PREVIEW BUILDS" Click="OpenBuilds_Click"
                      Style="{StaticResource CapriButton}" Margin="0,0,9,9"/>
            </WrapPanel>
            <TextBlock x:Name="UpdateStatus" Text="Press CHECK FOR UPDATES to contact official GitHub releases."
                       Foreground="{StaticResource CapriCyanBrush}"
                       TextWrapping="Wrap" Margin="0,7,0,0"/>
            <TextBlock Text="Automatic installation only runs from GitHub release assets after a full size + SHA-256 check. The installer is not yet Authenticode-signed; SHA-256 metadata is not a publisher signature. Use the checkbox above to turn unattended installation off."
                       Style="{StaticResource CapriSubtext}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,11,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CapriPanel}" Padding="16" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="/// PRE-PUBLISH READINESS" Style="{StaticResource CapriLabel}"/>
            <TextBlock Text="Run a local preflight for the AI brain, animation pack, audio, installed model and publisher account registrations. This does NOT contact your linked accounts, record audio or certify hardware."
                       Style="{StaticResource CapriSubtext}" TextWrapping="Wrap"
                       Margin="0,8,0,10"/>
            <TextBox x:Name="ReadinessReportBox" IsReadOnly="True"
                     Text="Run the readiness check to see configured, optional and publisher-blocked features."
                     Background="#0C1822" Foreground="{StaticResource CapriTextBrush}"
                     BorderBrush="#436778" BorderThickness="1"
                     FontFamily="Consolas" FontSize="11"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Height="238" Padding="10"/>
            <WrapPanel Margin="0,12,0,0">
              <Button x:Name="ReadinessButton" Content="RUN READINESS CHECK"
                      Click="Readiness_Click" Style="{StaticResource CapriPrimaryButton}"
                      Margin="0,0,9,9"/>
              <Button Content="COPY CHECK RESULTS" Click="CopyReadiness_Click"
                      Style="{StaticResource CapriButton}" Margin="0,0,9,9"/>
            </WrapPanel>
            <TextBlock x:Name="ReadinessFeedback"
                       Text="This checks setup, not physical-device performance. Review before sharing."
                       Foreground="{StaticResource CapriCyanBrush}" TextWrapping="Wrap"
                       FontSize="11"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CapriPanel}" Padding="16" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="/// CAPRI CHARACTER ART" Style="{StaticResource CapriLabel}"/>
            <TextBlock x:Name="ArtStatusText"
                       Text="Checking seven animated states…"
                       Foreground="{StaticResource CapriCyanBrush}"
                       FontFamily="Consolas" FontSize="12" Margin="0,9,0,8"/>
            <TextBlock Text="Seven default character animations ship with Capri. You only need Import Animation Pack to override those frames with your own local ZIP; your imported art is preserved during updates."
                       Style="{StaticResource CapriSubtext}" TextWrapping="Wrap"
                       Margin="0,0,0,12"/>
            <WrapPanel>
              <Button Content="IMPORT ANIMATION PACK" Click="ImportPack_Click"
                      Style="{StaticResource CapriPrimaryButton}" Margin="0,0,9,8"/>
              <Button Content="OPEN ART FOLDER" Click="OpenArtFolder_Click"
                      Style="{StaticResource CapriButton}" Margin="0,0,9,8"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CapriPanel}" Padding="16" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="/// LOCAL DIAGNOSTICS" Style="{StaticResource CapriLabel}"/>
            <TextBlock Text="No telemetry or automatic upload. Only timestamps, application/runtime version, and error categories/types are captured. No chat, memory, tokens, window titles, full paths, screenshots or stack traces."
                       Style="{StaticResource CapriSubtext}" TextWrapping="Wrap"
                       Margin="0,9,0,11"/>
            <TextBox x:Name="ReportBox" IsReadOnly="True"
                     Background="#0C1822" Foreground="{StaticResource CapriTextBrush}"
                     BorderBrush="#436778" BorderThickness="1"
                     FontFamily="Consolas" FontSize="11"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Height="190" Padding="10"/>
            <WrapPanel Margin="0,12,0,0">
              <Button Content="REFRESH REPORT" Click="RefreshReport_Click"
                      Style="{StaticResource CapriButton}" Margin="0,0,9,9"/>
              <Button Content="COPY REPORT" Click="CopyReport_Click"
                      Style="{StaticResource CapriPrimaryButton}" Margin="0,0,9,9"/>
              <Button Content="OPEN LOCAL DATA" Click="OpenData_Click"
                      Style="{StaticResource CapriButton}" Margin="0,0,9,9"/>
            </WrapPanel>
            <TextBlock x:Name="ReportFeedback" Foreground="{StaticResource CapriCyanBrush}"
                       TextWrapping="Wrap" FontSize="11"
                       Text="Nothing is shared until you choose to copy it."/>
          </StackPanel>
        </Border>
        <TextBlock Text="Capri Desktop is an unofficial fan companion. Versioned GitHub releases may be unsigned until code-signing is arranged."
                   Style="{StaticResource CapriSubtext}" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
    <Button Grid.Row="2" Content="BACK TO CAPRI" HorizontalAlignment="Right"
            Click="Close_Click" Style="{StaticResource CapriButton}" Margin="0,12,0,0"/>
  </Grid>
</Window>