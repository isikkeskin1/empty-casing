<Window x:Class="Capri.Desktop.Windows.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="800" MinWidth="520" MinHeight="630" Background="#0C101A"
        Foreground="#E1EBF7" Title="Capri Desktop — Mainframe"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="BorderTone" Color="#31404F"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E5F7FA"/>
      <Setter Property="Background" Value="#233142"/>
      <Setter Property="BorderBrush" Value="#52647B"/>
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F2F7FA"/>
      <Setter Property="Background" Value="#182334"/>
      <Setter Property="BorderBrush" Value="#405467"/>
      <Setter Property="Padding" Value="9"/>
      <Setter Property="CaretBrush" Value="#FB82A8"/>
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,15">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="CAPRI" FontFamily="Consolas" FontSize="34"
                   FontWeight="Bold" Foreground="#FA8EB3"/>
        <TextBlock Text="DESKTOP MAINFRAME  /  INDEPENDENT FAN BUILD"
                   FontFamily="Consolas" FontSize="10" Foreground="#9FA9B8"/>
      </StackPanel>
      <Border Grid.Column="1" VerticalAlignment="Center" Padding="9,6"
              Background="#1C2633" CornerRadius="4">
        <TextBlock x:Name="StatusDisplay" Text="CHECKING OLLAMA"
                   FontFamily="Consolas" FontSize="10" Foreground="#F1CFA0"/>
      </Border>
    </Grid>

    <Border Grid.Row="1" BorderBrush="{StaticResource BorderTone}" BorderThickness="1"
            Margin="0,0,0,12" Padding="10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="CHAT MODEL" Foreground="#92AABE" FontFamily="Consolas"
                   FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <TextBox x:Name="ModelBox" Grid.Column="1" MinWidth="100" Padding="6,5"/>
        <Button Grid.Column="2" Content="SAVE" Click="SaveModel_Click"
                Margin="8,0,0,0" Padding="10,5"/>
        <Button Grid.Column="3" Content="SET UP BRAIN" Click="SetupBrain_Click"
                Margin="8,0,0,0" Padding="10,5"/>
        <Button Grid.Column="4" Content="INPUTS" Click="OpenInputs_Click"
                Margin="8,0,0,0" Padding="10,5"/>
      </Grid>
    </Border>

    <Border Grid.Row="2" BorderBrush="{StaticResource BorderTone}" BorderThickness="1"
            Margin="0,0,0,12" Padding="10" Background="#121D2B">
      <StackPanel>
        <DockPanel>
          <TextBlock Text="VISION MODEL" VerticalAlignment="Center" Foreground="#92AABE"
                     FontFamily="Consolas" FontSize="11" Margin="0,0,10,0"/>
          <Button Content="LOOK NOW" DockPanel.Dock="Right" Click="Look_Click"
                  Padding="10,5" Margin="8,0,0,0"/>
          <TextBox x:Name="VisionModelBox" MinWidth="100" Padding="7,5"/>
        </DockPanel>
        <WrapPanel Margin="0,10,0,0">
          <CheckBox x:Name="WatchCheck" Content="WATCH SCREEN" Margin="0,0,18,8"
                    Checked="Watch_Changed" Unchecked="Watch_Changed"/>
          <CheckBox x:Name="MicCheck" Content="MIC ON" Margin="0,0,18,8"
                    Checked="Mic_Changed" Unchecked="Mic_Changed"/>
          <CheckBox x:Name="SpeakCheck" Content="SPEAK REPLIES" Margin="0,0,18,8"
                    Checked="Speak_Changed" Unchecked="Speak_Changed"/>
          <CheckBox x:Name="ActionsCheck" Content="DESKTOP ACTIONS" Margin="0,0,0,8"
                    Checked="Actions_Changed" Unchecked="Actions_Changed"/>
        </WrapPanel>
        <DockPanel Margin="0,4,0,10">
          <TextBlock Text="WATCH MONITOR" VerticalAlignment="Center" Foreground="#92ACBA"
                     FontSize="10" FontFamily="Consolas" Margin="0,0,10,0"/>
          <ComboBox x:Name="ScreenCombo" SelectionChanged="Screen_Changed"
                    MinWidth="190" MaxWidth="350" Padding="6,4"
                    Background="#182334" Foreground="#121B29"/>
        </DockPanel>
        <TextBlock Foreground="#849CAB" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"
                   Text="Vision: selected monitor, every 45s while watching. Customize hotkeys and microphone in INPUTS. Say 'Capri' before a command. Try: 'remind me in 10 minutes to stretch' or 'set a timer for 30 seconds'. Actions require approval; no purchases."/>
      </StackPanel>
    </Border>

    <Border Grid.Row="3" BorderBrush="{StaticResource BorderTone}" BorderThickness="1"
            Background="#111927" CornerRadius="4">
      <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Messages}" Margin="12">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="MessageBackground" Background="#1A2937"
                      BorderBrush="#38485C" BorderThickness="1" CornerRadius="6"
                      Padding="11" Margin="0,0,20,11">
                <StackPanel>
                  <DockPanel Margin="0,0,0,7">
                    <TextBlock Text="{Binding DisplayRole}" DockPanel.Dock="Left"
                               FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                               Foreground="#FA8EB3"/>
                    <TextBlock Text="{Binding DisplayTime}" Foreground="#8A9AAB"
                               FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right"/>
                  </DockPanel>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"
                             LineHeight="19"/>
                </StackPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Role}" Value="user">
                  <Setter TargetName="MessageBackground" Property="Background" Value="#292337"/>
                  <Setter TargetName="MessageBackground" Property="BorderBrush" Value="#5D486F"/>
                  <Setter TargetName="MessageBackground" Property="Margin" Value="20,0,0,11"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="system">
                  <Setter TargetName="MessageBackground" Property="Background" Value="#332027"/>
                  <Setter TargetName="MessageBackground" Property="BorderBrush" Value="#6C4351"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="4" Margin="0,12,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap"
               MinHeight="64" MaxHeight="135" VerticalScrollBarVisibility="Auto"
               KeyDown="Prompt_KeyDown"/>
      <Button x:Name="SendButton" Grid.Column="1" Width="100"
              Content="SEND ↗" FontWeight="SemiBold" Margin="10,0,0,0"
              Click="Send_Click"/>
    </Grid>
    <DockPanel Grid.Row="5">
      <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="CLEAR CHAT"
              Click="Clear_Click" FontSize="10" Padding="7,4"/>
      <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="REMINDERS"
              Click="ShowReminders_Click" Margin="0,0,8,0" FontSize="10" Padding="7,4"/>
      <TextBlock Text="ENTER SENDS   /   SHIFT+ENTER NEW LINE"
                 VerticalAlignment="Center" Foreground="#8293A6"
                 FontFamily="Consolas" FontSize="10"/>
    </DockPanel>
  </Grid>
</Window>
