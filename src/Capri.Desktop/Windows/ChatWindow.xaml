<Window x:Class="Capri.Desktop.Windows.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CAPRI  ·  Mainframe" Width="1340" Height="850"
        MinWidth="1020" MinHeight="700" WindowStartupLocation="CenterScreen"
        Background="{StaticResource CapriWindowAtmosphere}"
        Foreground="{StaticResource CapriTextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStyle="None" ResizeMode="CanResize">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38"
                        ResizeBorderThickness="7"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Grid Background="#090E18">
    <Grid.RowDefinitions>
      <RowDefinition Height="38"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <!-- Dark, draggable native-compatible chrome with explicit window actions. -->
    <Border Grid.Row="0" Background="#0D1320"
            BorderBrush="#27374A" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="17,0,0,0"
                    VerticalAlignment="Center">
          <Ellipse Width="9" Height="9" Margin="0,0,10,0"
                   Fill="{StaticResource CapriPinkBrush}"/>
          <TextBlock Text="CAPRI" Foreground="#E8ECF5"
                     FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                     VerticalAlignment="Center"/>
          <TextBlock Text="  /  MAINFRAME" Foreground="#71889E"
                     FontFamily="Consolas" FontSize="10"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="—" ToolTip="Minimize" Click="MinimizeWindow_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Width="48" Height="37" FontSize="13" FontFamily="Segoe UI"
                  Foreground="#C9D5E1" Background="Transparent"
                  BorderThickness="0" Cursor="Hand"/>
          <Button x:Name="MaximizeWindowButton" Content="□" ToolTip="Maximize or restore"
                  Click="ToggleMaximizeWindow_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Width="48" Height="37" FontSize="16"
                  Foreground="#C9D5E1" Background="Transparent"
                  BorderThickness="0" Cursor="Hand"/>
          <Button Content="×" ToolTip="Close" Click="CloseWindow_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Width="52" Height="37" FontSize="19"
                  Foreground="#FF96AD" Background="#251928"
                  BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Reduced visual chrome: the character and conversation hold focus. -->
    <Grid Margin="2,2,2,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="CAPRI" FontFamily="Bahnschrift SemiCondensed" FontSize="38"
                     FontWeight="ExtraBold" Foreground="{StaticResource CapriPinkBrush}"/>
          <TextBlock Text="/ mainframe" FontFamily="Segoe UI" FontSize="14"
                     Margin="13,18,0,0" Foreground="{StaticResource CapriCyanBrush}"/>
        </StackPanel>
        <TextBlock Text="A little company, all across your desktop."
                   Foreground="{StaticResource CapriMutedBrush}" FontSize="12"/>
      </StackPanel>
      <Border Grid.Column="1" VerticalAlignment="Center"
              BorderBrush="{StaticResource CapriTrimBrush}" BorderThickness="1"
              Background="{StaticResource CapriPanelBrush}"
              Padding="13,9" Margin="0,0,10,0" CornerRadius="10">
        <TextBlock x:Name="StatusDisplay" Text="CHECKING AI" FontFamily="Consolas"
                   FontSize="11" Foreground="{StaticResource CapriYellowBrush}"/>
      </Border>
      <Button Grid.Column="2" Content="Configure AI" Click="SetupBrain_Click"
              Style="{StaticResource CapriButton}" VerticalAlignment="Center"
              ToolTip="Choose a local or cloud model and configure voice."/>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="176"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Static sidebar: navigation stays available at every screen height. -->
      <Border Grid.Column="0" Style="{StaticResource CapriPanel}" Padding="11" Background="#0E1624" BorderBrush="#293A4E">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Bottom">
            <Border BorderBrush="#3D5962" BorderThickness="0,1,0,0" Padding="2,13,2,9">
              <StackPanel>
                <TextBlock Text="SYSTEM / ACCESS" Style="{StaticResource CapriLabel}"
                           Foreground="{StaticResource CapriYellowBrush}" Margin="0,0,0,8"/>
                <TextBlock x:Name="QuickMicState" Text="MIC  /  OFF"
                           Foreground="{StaticResource CapriMutedBrush}" FontFamily="Consolas"
                           FontSize="11" Margin="0,0,0,5"/>
                <TextBlock x:Name="QuickSenseState" Text="SENSE  /  OFF"
                           Foreground="{StaticResource CapriMutedBrush}" FontFamily="Consolas"
                           FontSize="11" Margin="0,0,0,5"/>
                <TextBlock x:Name="QuickActionsState" Text="ACTIONS  /  DISARMED"
                           Foreground="{StaticResource CapriMutedBrush}" FontFamily="Consolas"
                           FontSize="11" Margin="0,0,0,7"/>
                <TextBlock Text="You control when access is enabled."
                           Style="{StaticResource CapriSubtext}" FontSize="10"/>
              </StackPanel>
            </Border>
            <Button Content="⏹  Stop all access" Click="StopInputs_Click"
                    Style="{StaticResource CapriDangerButton}"
                    Margin="0,12,0,0"
                    ToolTip="Immediately turn off microphone, screen watch and desktop actions."/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="WORKSPACE" Style="{StaticResource CapriLabel}"
                       Margin="5,5,0,16"/>
            <Button x:Name="NavChat" Content="◈   Conversation" Tag="CHAT" Click="Navigate_Click"
                    Style="{StaticResource CapriNavActiveButton}"/>
            <Button x:Name="NavModes" Content="✦   Sessions" Tag="MODES" Click="Navigate_Click"
                    Style="{StaticResource CapriNavButton}"/>
            <Button x:Name="NavControls" Content="◎   Senses"
                    Tag="CONTROLS" Click="Navigate_Click"
                    Style="{StaticResource CapriNavButton}"/>
            <Button x:Name="NavConnect" Content="▣   Apps &amp; tools"
                    Tag="CONNECT" Click="Navigate_Click"
                    Style="{StaticResource CapriNavButton}"/>
            <Button x:Name="NavMemory" Content="◇   My memory" Tag="MEMORY"
                    Click="Navigate_Click" Style="{StaticResource CapriNavButton}"/>
            <Border Background="#172537" CornerRadius="12" Padding="13" Margin="3,25,3,0">
              <StackPanel>
                <TextBlock Text="YOUR DESKTOP, YOUR RULES" FontSize="9"
                           FontFamily="Consolas" Foreground="{StaticResource CapriCyanBrush}"/>
                <TextBlock Text="Capri doesn't watch or listen until you enable it."
                           TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                           Foreground="{StaticResource CapriMutedBrush}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- A single page title; voice and cancel actions stay in the composer. -->
        <Grid Margin="1,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="PageTitle" Text="Your conversation"
                       FontFamily="Bahnschrift SemiCondensed" FontSize="27"
                       FontWeight="SemiBold" Foreground="{StaticResource CapriTextBrush}"/>
            <TextBlock x:Name="PageSubtitle"
                       Text="Talk, create, play. Capri stays close."
                       Foreground="{StaticResource CapriMutedBrush}" FontSize="12"
                       Margin="0,3,0,0"/>
          </StackPanel>
          <Border Grid.Column="1" Background="#162236"
                  CornerRadius="12" BorderBrush="#304559"
                  BorderThickness="1" Padding="12,7"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse Fill="{StaticResource CapriPinkBrush}" Width="7" Height="7"
                       Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="YOUR PERSONAL SPACE" FontFamily="Consolas"
                         FontSize="10" Foreground="{StaticResource CapriMutedBrush}"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Conversation + companion as one visual experience. The larger
             art-stage responds to the same moods as the floating companion. -->
        <Border x:Name="ChatPage" Grid.Row="1"
                Background="#0F1725" BorderBrush="#314054"
                BorderThickness="1" CornerRadius="19"
                ClipToBounds="True" Padding="0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44*" MinWidth="330"/>
              <ColumnDefinition Width="56*" MinWidth="395"/>
            </Grid.ColumnDefinitions>

            <!-- Large atmospheric character stage, not a thumbnail card. -->
            <Border Grid.Column="0" Background="{StaticResource CapriHeroBackground}"
                    BorderBrush="#39425A" BorderThickness="0,0,1,0"
                    CornerRadius="19,0,0,19" ClipToBounds="True">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="25,22,25,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="YOUR COMPANION" FontFamily="Consolas"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource CapriCyanBrush}"/>
                    <TextBlock Text="Capri" FontFamily="Bahnschrift SemiCondensed"
                               FontSize="36" FontWeight="Bold"
                               Foreground="#FFF4F8" Margin="0,1,0,0"/>
                  </StackPanel>
                  <Border Grid.Column="1" Height="30" VerticalAlignment="Center"
                          Background="#31253B" BorderBrush="#805271"
                          BorderThickness="1" CornerRadius="15" Padding="11,5">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse x:Name="HeroMoodDot" Width="7" Height="7"
                               Fill="{StaticResource CapriLimeBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBlock x:Name="HeroMoodTitle" Text="HERE WITH YOU"
                                 FontFamily="Consolas" FontSize="10"
                                 Foreground="#F7DAEA" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- Full-height artwork space, clipped safely when the window
                     shrinks. Oversized default sprites remain centered. -->
                <Grid Grid.Row="1" ClipToBounds="True">
                  <Ellipse Width="420" Height="420"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Fill="#152338" Opacity="0.46"/>
                  <Ellipse Width="390" Height="390"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Stroke="#8C537D" StrokeThickness="1" Opacity="0.42"/>
                  <Ellipse Width="305" Height="305"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Stroke="#47718A" StrokeThickness="1" Opacity="0.35"/>
                  <Ellipse Width="265" Height="265" Opacity="0.18"
                           VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse.Fill>
                      <RadialGradientBrush>
                        <GradientStop Color="#B71A76" Offset="0"/>
                        <GradientStop Color="#6A2A72" Offset="0.48"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                      </RadialGradientBrush>
                    </Ellipse.Fill>
                  </Ellipse>
                  <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           Margin="4,0,4,0">
                    <Image x:Name="HeroArtImage" Stretch="Uniform"
                           Width="450" Height="460"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                  </Viewbox>
                  <TextBlock x:Name="HeroArtStatus"
                             Text="LOADING ANIMATIONS..."
                             VerticalAlignment="Bottom" HorizontalAlignment="Center"
                             Margin="16" FontFamily="Consolas" FontSize="11"
                             TextWrapping="Wrap" TextAlignment="Center"
                             Foreground="{StaticResource CapriMutedBrush}"/>
                </Grid>

                <Border Grid.Row="2" Margin="17,0,17,17"
                        Padding="17" CornerRadius="14"
                        Background="#D9101C2E" BorderBrush="#57445D"
                        BorderThickness="1">
                  <StackPanel>
                    <TextBlock x:Name="HeroMoodCaption"
                               Text="Ready to hang out, help with a game or get something done."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="#D7E5EE" Margin="0,0,0,12"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Button x:Name="TalkOnceButton" Grid.Column="0"
                              Content="◉  Talk once" Click="TalkOnce_Click"
                              Style="{StaticResource CapriPrimaryButton}"
                              Padding="8,10" FontSize="12"
                              ToolTip="Listen for one request. No wake word needed."/>
                      <Button Grid.Column="2" Content="◎  Look now"
                              Click="Look_Click" Style="{StaticResource CapriButton}"
                              Padding="8,10" FontSize="12"
                              ToolTip="Analyze one selected screen frame; cloud sharing asks permission."/>
                    </Grid>
                    <TextBlock Text="Artwork: Lachy / PolyForm Noncommercial"
                               Foreground="#A99DB1" FontSize="9"
                               Margin="0,11,0,0"
                               ToolTip="Upstream project lachydotmcg/capri-desktop. The artist prefers to stay private."/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <!-- Right side is deliberately calm; starter prompts make a
                 one-message conversation useful instead of a blank slab. -->
            <Grid Grid.Column="1" Margin="23,22,22,18">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid Margin="2,0,2,17">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="THE CONVERSATION" FontFamily="Consolas"
                             Foreground="{StaticResource CapriCyanBrush}"
                             FontSize="10" FontWeight="SemiBold"/>
                  <TextBlock Text="Speak freely."
                             Foreground="{StaticResource CapriTextBrush}"
                             FontFamily="Bahnschrift SemiCondensed"
                             FontSize="25" FontWeight="SemiBold"
                             Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center"
                        Background="#1A2837" CornerRadius="9"
                        Padding="9,6">
                  <TextBlock Text="PRIVATE HISTORY" FontFamily="Consolas"
                             FontSize="9" Foreground="#99BCC1"/>
                </Border>
              </Grid>
              <ScrollViewer x:Name="TranscriptScroll" Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            Padding="0,0,5,0">
                <ItemsControl ItemsSource="{Binding Messages}" Margin="1,0,3,8">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border x:Name="MessageBackground" Background="#1B293B"
                              BorderBrush="#2C4257" BorderThickness="1"
                              CornerRadius="13,13,13,5" Padding="16,14"
                              Margin="0,0,35,11">
                        <StackPanel>
                          <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DisplayRole}" FontSize="10"
                                       FontFamily="Consolas" FontWeight="Bold"
                                       Foreground="{StaticResource CapriCyanBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding DisplayTime}"
                                       Foreground="#7C93A9" FontFamily="Consolas"
                                       FontSize="10"/>
                          </Grid>
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                     FontSize="14" LineHeight="23"
                                     Foreground="#EBF1F8"/>
                        </StackPanel>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Role}" Value="user">
                          <Setter TargetName="MessageBackground" Property="Background" Value="#34253D"/>
                          <Setter TargetName="MessageBackground" Property="BorderBrush" Value="#6B4668"/>
                          <Setter TargetName="MessageBackground" Property="CornerRadius" Value="13,13,5,13"/>
                          <Setter TargetName="MessageBackground" Property="Margin" Value="35,0,0,11"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Role}" Value="stream">
                          <Setter TargetName="MessageBackground" Property="BorderBrush" Value="#48636A"/>
                          <Setter TargetName="MessageBackground" Property="Opacity" Value="0.88"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <Border x:Name="StarterPanel" Grid.Row="2"
                      Background="#162235" BorderBrush="#304457"
                      BorderThickness="1" CornerRadius="14" Padding="14"
                      Margin="0,9,0,0">
                <StackPanel>
                  <TextBlock Text="NOT SURE WHERE TO START?"
                             Foreground="#A9BACE" FontFamily="Consolas"
                             FontSize="10" Margin="0,0,0,10"/>
                  <WrapPanel>
                    <Button Content="✦  What can you do?"
                            Tag="What can you help me with on my computer?"
                            Click="SuggestedPrompt_Click"
                            Style="{StaticResource CapriButton}"
                            FontSize="11" MinHeight="34" Padding="9,7"
                            Margin="0,0,7,7"/>
                    <Button Content="◈  Plan a session"
                            Tag="Help me plan a productive session."
                            Click="SuggestedPrompt_Click"
                            Style="{StaticResource CapriButton}"
                            FontSize="11" MinHeight="34" Padding="9,7"
                            Margin="0,0,7,7"/>
                    <Button Content="◎  Game help"
                            Click="StarterGameHelp_Click"
                            Style="{StaticResource CapriButton}"
                            FontSize="11" MinHeight="34" Padding="9,7"
                            Margin="0,0,7,0"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Border>

        <!-- Dedicated, readable launch cards instead of an intimidating wall of controls. -->
        <ScrollViewer x:Name="ModesPage" Grid.Row="1" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource CapriPanel}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="/// ONE COMMAND, MULTIPLE APPS" Style="{StaticResource CapriLabel}"/>
                <TextBlock Text="Pick a setup and Capri opens the apps for you. Your computer remains in control."
                           Style="{StaticResource CapriSubtext}" Margin="0,7,0,0"/>
              </StackPanel>
            </Border>
            <WrapPanel>
              <Border Style="{StaticResource CapriPanel}" Width="282" Margin="0,0,12,12">
                <StackPanel>
                  <TextBlock Text="GAMING SESSION" FontSize="18" FontWeight="Bold"
                             Foreground="{StaticResource CapriYellowBrush}"/>
                  <TextBlock Text="Discord  +  Steam  +  Spotify"
                             Style="{StaticResource CapriSubtext}" Margin="0,8,0,18"/>
                  <Button Content="START GAMING" Tag="gaming mode" Click="LaunchRoutine_Click"
                          Style="{StaticResource CapriPrimaryButton}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CapriPanel}" Width="282" Margin="0,0,12,12">
                <StackPanel>
                  <TextBlock Text="ROBLOX SESSION" FontSize="18" FontWeight="Bold"
                             Foreground="{StaticResource CapriYellowBrush}"/>
                  <TextBlock Text="Discord  +  Roblox home  +  Spotify"
                             Style="{StaticResource CapriSubtext}" Margin="0,8,0,18"/>
                  <Button Content="OPEN ROBLOX MODE" Tag="roblox mode"
                          Click="LaunchRoutine_Click" Style="{StaticResource CapriPrimaryButton}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CapriPanel}" Width="282" Margin="0,0,12,12">
                <StackPanel>
                  <TextBlock Text="ROBLOX DEVELOPMENT" FontSize="18" FontWeight="Bold"
                             Foreground="{StaticResource CapriCyanBrush}"/>
                  <TextBlock Text="Creator Dashboard  +  VS Code  +  Spotify"
                             Style="{StaticResource CapriSubtext}" Margin="0,8,0,18"/>
                  <Button Content="START BUILDING" Tag="roblox dev mode"
                          Click="LaunchRoutine_Click" Style="{StaticResource CapriPrimaryButton}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CapriPanel}" Width="282" Margin="0,0,12,12">
                <StackPanel>
                  <TextBlock Text="FOCUS SESSION" FontSize="18" FontWeight="Bold"
                             Foreground="{StaticResource CapriCyanBrush}"/>
                  <TextBlock Text="VS Code  +  Notepad  +  Spotify"
                             Style="{StaticResource CapriSubtext}" Margin="0,8,0,18"/>
                  <Button Content="LOCK IN" Tag="study mode" Click="LaunchRoutine_Click"
                          Style="{StaticResource CapriPrimaryButton}"/>
                </StackPanel>
              </Border>
            </WrapPanel>
            <Border Style="{StaticResource CapriPanel}" Margin="0,2,0,12">
              <StackPanel>
                <TextBlock Text="/// BEFORE YOU LAUNCH" Style="{StaticResource CapriLabel}"/>
                <TextBlock Text="Turn on Desktop Actions in Senses &amp; Control. Regular mode asks once for the whole routine; Hands-free skips routine approval. STOP ALL always cancels any remaining steps. The cards open apps; they don't silently join calls or start music."
                           Style="{StaticResource CapriSubtext}" Margin="0,9,0,14"/>
                <Button Content="VIEW CONTROL SETTINGS" Tag="CONTROLS" Click="Navigate_Click"
                        Style="{StaticResource CapriButton}" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Explicitly grouped permission switches; no endless all-in-one toolbar. -->
        <ScrollViewer x:Name="ControlsPage" Grid.Row="1" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource CapriPanel}" Margin="0,0,0,13">
              <StackPanel>
                <TextBlock Text="/// VOICE" Style="{StaticResource CapriLabel}"/>
                <TextBlock Text="Talk naturally. Microphone access stays off until you enable it."
                           Style="{StaticResource CapriSubtext}" Margin="0,5,0,13"/>
                <WrapPanel>
                  <CheckBox x:Name="MicCheck" Content="Microphone on" Style="{StaticResource CapriToggle}"
                            Checked="Mic_Changed" Unchecked="Mic_Changed"/>
                  <CheckBox x:Name="SpeakCheck" Content="Speak replies" Style="{StaticResource CapriToggle}"
                            Checked="Speak_Changed" Unchecked="Speak_Changed"/>
                  <CheckBox x:Name="QuietCheck" Content="Quiet mode (no commentary)"
                            ToolTip="Session-only. Suppresses unsolicited speech and visual comments, but requested reminder notifications still work."
                            Style="{StaticResource CapriToggle}"
                            Checked="Quiet_Changed" Unchecked="Quiet_Changed"/>
                </WrapPanel>
                <WrapPanel>
                  <Button Content="STOP SPEAKING" Click="StopVoice_Click"
                          Style="{StaticResource CapriButton}" Margin="0,0,9,8"/>
                  <Button Content="VOICE INPUT SETTINGS" Click="OpenInputs_Click"
                          Style="{StaticResource CapriButton}" Margin="0,0,9,8"/>
                  <Button Content="CALL COMPANION" Click="OpenCallCompanion_Click"
                          Style="{StaticResource CapriButton}" Margin="0,0,9,8"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CapriPanel}" Margin="0,0,0,13">
              <StackPanel>
                <TextBlock Text="/// PRESENCE &amp; VISION" Style="{StaticResource CapriLabel}"/>
                <TextBlock Text="Choose exactly what Capri notices. Screen shots sent to a cloud model require separate permission."
                           Style="{StaticResource CapriSubtext}" Margin="0,5,0,13"/>
                <WrapPanel>
                  <CheckBox x:Name="WatchCheck" Content="Watch screen" Style="{StaticResource CapriToggle}"
                            Checked="Watch_Changed" Unchecked="Watch_Changed"/>
                  <CheckBox x:Name="PresenceCheck" Content="Live presence (local)"
                            ToolTip="Detect app/music changes. Metadata stays local unless Context Sense is also enabled for chat."
                            Style="{StaticResource CapriToggle}"
                            Checked="Presence_Changed" Unchecked="Presence_Changed"/>
                  <CheckBox x:Name="ContextCheck" Content="Share app/music context with brain"
                            ToolTip="Opt in to include foreground process and media metadata in chat, including with your cloud brain."
                            Style="{StaticResource CapriToggle}"
                            Checked="Context_Changed" Unchecked="Context_Changed"/>
                  <CheckBox x:Name="DanceCheck" Content="React to system audio"
                            Style="{StaticResource CapriToggle}"
                            Checked="Dance_Changed" Unchecked="Dance_Changed"/>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,10">
                  <Button Content="LOOK NOW" Click="Look_Click"
                          Style="{StaticResource CapriPrimaryButton}" Margin="0,0,9,8"/>
                  <Button Content="GAME HELP" Click="GameHelp_Click"
                          Style="{StaticResource CapriButton}" Margin="0,0,9,8"/>
                </WrapPanel>
                <WrapPanel>
                  <StackPanel Margin="0,0,13,12">
                    <TextBlock Text="WATCH MONITOR" Style="{StaticResource CapriLabel}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ScreenCombo" SelectionChanged="Screen_Changed"
                              MinWidth="215" Padding="7,7" Background="#182A39"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="CHECK EVERY" Style="{StaticResource CapriLabel}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="WatchIntervalBox" SelectionChanged="WatchInterval_Changed"
                              MinWidth="175" Padding="7,7" Background="#182A39"/>
                  </StackPanel>
                </WrapPanel>
                <Border BorderBrush="#36596A" BorderThickness="1"
                        Background="#10212B" Padding="12" Margin="0,3,0,0"
                        CornerRadius="0,7,0,0">
                  <StackPanel>
                    <TextBlock Text="/// VISUAL LOOKOUT" Style="{StaticResource CapriLabel}"
                               Foreground="{StaticResource CapriYellowBrush}"/>
                    <TextBlock Text="Tell Capri what to watch for, such as a low health bar or a finished download. Requires WATCH SCREEN; cloud screenshots use the same permission."
                               Style="{StaticResource CapriSubtext}" Margin="0,7,0,11"/>
                    <TextBox x:Name="LookoutConditionBox"
                             Style="{StaticResource CapriInput}"
                             Text="my health is low"
                             ToolTip="A visible condition, e.g. the download finishes."
                             Margin="0,0,0,10"/>
                    <WrapPanel>
                      <Button Content="START LOOKOUT" Click="StartLookout_Click"
                              Style="{StaticResource CapriPrimaryButton}" Margin="0,0,9,8"/>
                      <Button Content="CANCEL LOOKOUT" Click="CancelLookout_Click"
                              Style="{StaticResource CapriButton}" Margin="0,0,9,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="LookoutStatusText" Text="No screen alert armed."
                               Foreground="{StaticResource CapriMutedBrush}"
                               TextWrapping="Wrap" FontSize="11"
                               Margin="0,3,0,0"/>
                    <TextBlock Text="Visual detection is an AI estimate, not a guaranteed game telemetry feed. Lookouts expire after two hours and never control the game."
                               Style="{StaticResource CapriSubtext}" FontSize="10"
                               Margin="0,7,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CapriPanel}" Margin="0,0,0,13">
              <StackPanel>
                <TextBlock Text="/// DESKTOP CONTROL" Style="{StaticResource CapriLabel}"/>
                <TextBlock Text="Allow safe launches, media controls and bounded navigation. Hands-free skips repeat approval for supported actions."
                           Style="{StaticResource CapriSubtext}" Margin="0,5,0,13"/>
                <WrapPanel>
                  <CheckBox x:Name="ActionsCheck" Content="Desktop actions"
                            Style="{StaticResource CapriToggle}"
                            Checked="Actions_Changed" Unchecked="Actions_Changed"/>
                  <CheckBox x:Name="HandsFreeCheck" Content="Hands-free · no popups"
                            Style="{StaticResource CapriToggle}"
                            Checked="HandsFree_Changed" Unchecked="HandsFree_Changed"/>
                </WrapPanel>
                <WrapPanel>
                  <Button Content="WINDOW CONTROLS" Click="OpenUiInspector_Click"
                          Style="{StaticResource CapriButton}" Margin="0,0,9,8"/>
                  <Button Content="AUTO TASK" Click="OpenAutoTask_Click"
                          Style="{StaticResource CapriButton}" Margin="0,0,9,8"/>
                  <Button Content="STOP ALL" Click="StopInputs_Click"
                          Style="{StaticResource CapriDangerButton}" Margin="0,0,9,8"/>
                </WrapPanel>
                <TextBlock Text="Purchases, messages, credentials, arbitrary commands and deletion are not granted by Hands-free."
                           Style="{StaticResource CapriSubtext}" Margin="0,5,0,0" FontSize="11"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CapriPanel}" Margin="0,0,0,13">
              <StackPanel>
                <TextBlock Text="/// MODEL CONFIGURATION" Style="{StaticResource CapriLabel}"/>
                <TextBlock Text="Edit model names without reopening the setup wizard."
                           Style="{StaticResource CapriSubtext}" Margin="0,5,0,14"/>
                <TextBlock Text="CHAT MODEL" Style="{StaticResource CapriLabel}" Margin="0,0,0,5"/>
                <TextBox x:Name="ModelBox" Style="{StaticResource CapriInput}" Margin="0,0,0,12"/>
                <TextBlock Text="VISION MODEL" Style="{StaticResource CapriLabel}" Margin="0,0,0,5"/>
                <TextBox x:Name="VisionModelBox" Style="{StaticResource CapriInput}" Margin="0,0,0,12"/>
                <WrapPanel>
                  <Button Content="SAVE MODEL NAMES" Click="SaveModel_Click"
                          Style="{StaticResource CapriPrimaryButton}" Margin="0,0,9,0"/>
                  <Button Content="SET UP BRAIN" Click="SetupBrain_Click"
                          Style="{StaticResource CapriButton}"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Connections remain separate OAuth windows, shown as clear entry points. -->
        <ScrollViewer x:Name="ConnectionsPage" Grid.Row="1" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource CapriPanel}" Margin="0,0,0,13">
              <StackPanel>
                <TextBlock Text="/// CONNECTED ACCOUNTS" Style="{StaticResource CapriLabel}"/>
                <TextBlock Text="Connect your own Spotify and Roblox accounts through official authorization."
                           Style="{StaticResource CapriSubtext}" Margin="0,8,0,15"/>
                <Button Content="OPEN SPOTIFY &amp; ROBLOX CONNECTIONS"
                        Click="OpenConnections_Click" Style="{StaticResource CapriPrimaryButton}"
                        HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CapriPanel}" Margin="0,0,0,13">
              <StackPanel>
                <TextBlock Text="/// MUSIC" Style="{StaticResource CapriLabel}"/>
                <TextBlock Text="See what is playing in Windows and control compatible media sessions."
                           Style="{StaticResource CapriSubtext}" Margin="0,8,0,15"/>
                <Button Content="OPEN NOW PLAYING" Click="OpenNowPlaying_Click"
                        Style="{StaticResource CapriButton}" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CapriPanel}" Margin="0,0,0,13">
              <StackPanel>
                <TextBlock Text="/// GAMES" Style="{StaticResource CapriLabel}"/>
                <TextBlock Text="Browse installed Steam games and get screenshot-based guidance."
                           Style="{StaticResource CapriSubtext}" Margin="0,8,0,15"/>
                <Button Content="OPEN GAME CENTER" Click="OpenGames_Click"
                        Style="{StaticResource CapriButton}" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
            <!-- OBS WebSocket replay integration: explicit, localhost-only,
                 encrypted password and an always-visible per-session arm switch. -->
            <Border Style="{StaticResource CapriPanel}" Margin="0,0,0,13">
              <StackPanel>
                <TextBlock Text="/// GAME CLIPS / OBS REPLAY" Style="{StaticResource CapriLabel}"
                           Foreground="{StaticResource CapriYellowBrush}"/>
                <TextBlock Text="Save real gameplay video with 'Capri, clip that'. Requires OBS Studio's Replay Buffer and local WebSocket server."
                           Style="{StaticResource CapriSubtext}" Margin="0,7,0,11"/>
                <WrapPanel Margin="0,0,0,6">
                  <StackPanel Margin="0,0,10,9">
                    <TextBlock Text="LOCAL PORT" Style="{StaticResource CapriLabel}"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="ObsPortBox" Width="102" Text="4455"
                             Style="{StaticResource CapriInput}"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,10,9">
                    <TextBlock Text="OBS WEBSOCKET PASSWORD" Style="{StaticResource CapriLabel}"
                               Margin="0,0,0,5"/>
                    <PasswordBox x:Name="ObsPasswordBox" Width="215"
                                 MinHeight="35" Padding="10,7" FontSize="13"
                                 Background="#182A39" Foreground="{StaticResource CapriTextBrush}"
                                 BorderBrush="#537183" BorderThickness="1"
                                 ToolTip="Paste the password from OBS → Tools → WebSocket Server Settings. Stored encrypted for this Windows user."/>
                  </StackPanel>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,7">
                  <Button Content="SAVE CONNECTION" Click="ObsSaveCredentials_Click"
                          Style="{StaticResource CapriPrimaryButton}" Margin="0,0,9,8"/>
                  <Button Content="FORGET PASSWORD" Click="ObsForgetPassword_Click"
                          Style="{StaticResource CapriButton}" Margin="0,0,9,8"/>
                </WrapPanel>
                <CheckBox x:Name="ObsArmedCheck"
                          Content="Enable clip controls for this session"
                          Style="{StaticResource CapriToggle}"
                          Checked="ObsArmed_Changed" Unchecked="ObsArmed_Changed"/>
                <TextBlock x:Name="ObsClipStatusText"
                           Text="DISARMED · Capri cannot control OBS clips"
                           Foreground="{StaticResource CapriCyanBrush}"
                           FontFamily="Consolas" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                <WrapPanel Margin="0,0,0,3">
                  <Button Content="CHECK OBS" Tag="GetReplayBufferStatus"
                          Click="ObsReplay_Click" Style="{StaticResource CapriButton}"
                          Margin="0,0,9,8"/>
                  <Button Content="START BUFFER" Tag="StartReplayBuffer"
                          Click="ObsReplay_Click" Style="{StaticResource CapriButton}"
                          Margin="0,0,9,8"/>
                  <Button Content="SAVE CLIP" Tag="SaveReplayBuffer"
                          Click="ObsReplay_Click" Style="{StaticResource CapriPrimaryButton}"
                          Margin="0,0,9,8"/>
                </WrapPanel>
                <WrapPanel>
                  <Button Content="FIND LAST CLIP" Tag="GetLastReplayBufferReplay"
                          Click="ObsReplay_Click" Style="{StaticResource CapriButton}"
                          Margin="0,0,9,8"/>
                  <Button Content="SHOW SAVED FILE" Click="ObsShowClip_Click"
                          Style="{StaticResource CapriButton}" Margin="0,0,9,8"/>
                </WrapPanel>
                <TextBlock x:Name="ObsClipFeedbackText"
                           Text="Set up OBS Replay Buffer first; clip length, audio and file location are controlled by OBS."
                           Style="{StaticResource CapriSubtext}" FontSize="11"
                           Margin="0,5,0,10"/>
                <TextBlock Text="Your OBS password is encrypted locally, never included in chat. Clip commands send only fixed requests to 127.0.0.1. STOP ALL disarms the connection. No streaming, uploads or automatic recordings."
                           Style="{StaticResource CapriSubtext}" FontSize="10"/>
              </StackPanel>
            </Border>
            <!-- Code/Husk watches only sanitized lifecycle events from user-installed
                 local coding-agent hooks. It cannot answer approvals or run tools. -->
            <Border Style="{StaticResource CapriPanel}" Margin="0,0,0,13">
              <StackPanel>
                <TextBlock Text="/// CODE / HUSK" Style="{StaticResource CapriLabel}"
                           Foreground="{StaticResource CapriYellowBrush}"/>
                <TextBlock Text="Capri follows Codex and Claude Code progress without reading prompts, code, or file contents."
                           Style="{StaticResource CapriSubtext}" Margin="0,7,0,14"/>
                <CheckBox x:Name="HuskWatchCheck" Content="Watch coding assistants (this session)"
                          Style="{StaticResource CapriToggle}"
                          Checked="HuskWatch_Changed" Unchecked="HuskWatch_Changed"/>
                <TextBlock x:Name="HuskStatusText"
                           Text="OFF · no coding events are read"
                           Foreground="{StaticResource CapriCyanBrush}"
                           FontFamily="Consolas" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,9"/>
                <TextBlock x:Name="HuskRecentText"
                           Text="No coding milestones in this session."
                           Foreground="{StaticResource CapriMutedBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,13"/>
                <TextBlock Text="/// CODING ASSISTANT INTEGRATIONS"
                           Style="{StaticResource CapriLabel}"
                           Margin="0,0,0,9"/>
                <WrapPanel>
                  <Button Content="INSTALL CODEX HOOKS" Tag="codex"
                          Click="HuskInstall_Click" Style="{StaticResource CapriPrimaryButton}"
                          Margin="0,0,9,9"/>
                  <Button Content="REMOVE CODEX HOOKS" Tag="codex"
                          Click="HuskRemove_Click" Style="{StaticResource CapriButton}"
                          Margin="0,0,9,9"/>
                </WrapPanel>
                <WrapPanel>
                  <Button Content="INSTALL CLAUDE HOOKS" Tag="claude"
                          Click="HuskInstall_Click" Style="{StaticResource CapriPrimaryButton}"
                          Margin="0,0,9,9"/>
                  <Button Content="REMOVE CLAUDE HOOKS" Tag="claude"
                          Click="HuskRemove_Click" Style="{StaticResource CapriButton}"
                          Margin="0,0,9,9"/>
                </WrapPanel>
                <TextBlock Text="Installing edits your own hook JSON after approval and backs it up. Restart the coding assistant. Hooks never approve tasks or send data to a server. Turning off Watch stops the relay; use Remove to uninstall hooks."
                           Style="{StaticResource CapriSubtext}" FontSize="10"
                           Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CapriPanel}" Margin="0,0,0,13">
              <StackPanel>
                <TextBlock Text="/// TOOLS" Style="{StaticResource CapriLabel}"/>
                <TextBlock Text="Review a selected text file, or schedule reminders for a specific date and time."
                           Style="{StaticResource CapriSubtext}" Margin="0,8,0,15"/>
                <TextBlock Text="Example: remind me on 5 December at 9am to call Mum."
                           Style="{StaticResource CapriSubtext}" Margin="0,0,0,13" FontSize="11"/>
                <WrapPanel>
                  <Button Content="READ FILE" Click="ReadFile_Click"
                          Style="{StaticResource CapriButton}" Margin="0,0,10,8"/>
                  <Button Content="REMINDERS" Click="ShowReminders_Click"
                          Style="{StaticResource CapriButton}" Margin="0,0,10,8"/>
                  <Button Content="ROUTINE COMMANDS" Click="ListRoutines_Click"
                          Style="{StaticResource CapriButton}" Margin="0,0,10,8"/>
                  <Button Content="DRAW ON SCREEN" Click="SketchMode_Click"
                          Style="{StaticResource CapriButton}" Margin="0,0,10,8"/>
                  <Button Content="ABOUT / UPDATES" Click="OpenUpdates_Click"
                          Style="{StaticResource CapriPrimaryButton}" Margin="0,0,10,8"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Local Memory Vault, separate from chat history and screen sensing. -->
        <ScrollViewer x:Name="MemoryPage" Grid.Row="1" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="2,0,6,0">
            <Border Style="{StaticResource CapriPanel}" Padding="17" Margin="0,0,0,13">
              <StackPanel>
                <TextBlock Text="/// MY MEMORY VAULT" Style="{StaticResource CapriLabel}"
                           Foreground="{StaticResource CapriYellowBrush}" FontSize="15"/>
                <TextBlock Text="Only facts you explicitly save appear here. Capri never mines chat history, screens, files or contacts to create memories."
                           Style="{StaticResource CapriSubtext}" Margin="0,9,0,16"/>
                <CheckBox x:Name="UseMemoryCheck" Content="Use my saved notes in AI replies"
                          Style="{StaticResource CapriToggle}"
                          Checked="UseMemory_Changed" Unchecked="UseMemory_Changed"/>
                <TextBlock Text="OFF by default. Notes stay on this Windows PC unless enabled. Cloud AI requires separate approval per provider; switching providers cannot silently share them."
                           Style="{StaticResource CapriSubtext}" Margin="0,0,0,11"
                           FontSize="11"/>
                <TextBlock x:Name="MemorySharingStatus"
                           Foreground="{StaticResource CapriCyanBrush}"
                           Text="Memory context disabled"
                           TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CapriPanel}" Padding="17" Margin="0,0,0,13">
              <StackPanel>
                <TextBlock Text="/// SAVED NOTES" Style="{StaticResource CapriLabel}"
                           Margin="0,0,0,9"/>
                <TextBlock x:Name="MemoryCountText" Text="0 / 40 saved facts"
                           Style="{StaticResource CapriSubtext}" Margin="0,0,0,8"/>
                <ListBox x:Name="MemoryList" Height="170"
                         Background="#101F2A" Foreground="{StaticResource CapriTextBrush}"
                         BorderBrush="#3D7181" BorderThickness="1"
                         DisplayMemberPath="Text"
                         SelectionChanged="MemorySelected_Changed"
                         Padding="9" Margin="0,0,0,10"/>
                <TextBlock Text="ADD OR EDIT A NOTE" Style="{StaticResource CapriLabel}"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="MemoryNoteBox" MaxLength="240"
                         Style="{StaticResource CapriInput}"
                         MinHeight="39" TextWrapping="Wrap"
                         ToolTip="An ordinary short fact. Don't store passwords or API keys."
                         Margin="0,0,0,11"/>
                <WrapPanel Margin="0,0,0,4">
                  <Button Content="SAVE NEW NOTE" Click="MemoryAdd_Click"
                          Style="{StaticResource CapriPrimaryButton}" Margin="0,0,8,8"/>
                  <Button Content="UPDATE SELECTED" Click="MemoryEdit_Click"
                          Style="{StaticResource CapriButton}" Margin="0,0,8,8"/>
                  <Button Content="FORGET SELECTED" Click="MemoryDelete_Click"
                          Style="{StaticResource CapriButton}" Margin="0,0,8,8"/>
                </WrapPanel>
                <WrapPanel>
                  <Button Content="EXPORT NOTES" Click="MemoryExport_Click"
                          Style="{StaticResource CapriButton}" Margin="0,0,8,8"/>
                  <Button Content="FORGET EVERYTHING" Click="MemoryClear_Click"
                          Style="{StaticResource CapriDangerButton}" Margin="0,0,8,8"/>
                </WrapPanel>
                <TextBlock x:Name="MemoryFeedbackText"
                           Text="Try: remember that I prefer short answers."
                           TextWrapping="Wrap" Foreground="{StaticResource CapriCyanBrush}"
                           Margin="0,9,0,0" FontSize="11"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- One conversation composer for every page. Voice, send and stop
             actions now live together instead of being scattered around. -->
        <Border Grid.Row="2" Margin="0,12,0,9" Padding="10"
                Background="#131F2F" BorderBrush="#33485C"
                BorderThickness="1" CornerRadius="15">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="105"/>
            </Grid.ColumnDefinitions>
            <Grid>
              <TextBox x:Name="PromptBox" Style="{StaticResource CapriInput}"
                       Background="#101A29" BorderBrush="#28384A"
                       AcceptsReturn="True" TextWrapping="Wrap"
                       MinHeight="44" MaxHeight="132"
                       VerticalScrollBarVisibility="Auto"
                       KeyDown="Prompt_KeyDown"
                       ToolTip="Enter to send · Shift+Enter to add a line"/>
              <TextBlock Text="Ask Capri something, or tell her what to do..."
                         Margin="15,0,0,0" VerticalAlignment="Center"
                         Foreground="#8397AD" FontSize="13"
                         IsHitTestVisible="False">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ElementName=PromptBox, Path=Text}"
                                   Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
            <Button x:Name="SendButton" Grid.Column="2"
                    Content="Send  ↗" Click="Send_Click"
                    Style="{StaticResource CapriPrimaryButton}"
                    FontSize="13" FontWeight="Bold"/>
          </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="2,0,2,1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center"
                     Text="ENTER TO SEND  ·  SHIFT+ENTER FOR A NEW LINE"
                     Foreground="#7790A4" FontFamily="Consolas"
                     FontSize="10" TextTrimming="CharacterEllipsis"/>
          <Button Grid.Column="1" Content="Stop reply"
                  Click="CancelReply_Click"
                  Style="{StaticResource CapriDangerButton}"
                  FontSize="11" MinHeight="30" Padding="12,6"
                  Margin="0,0,9,0" ToolTip="Cancel the current response or speech."/>
          <Button Grid.Column="2" Content="Clear history" Click="Clear_Click"
                  Style="{StaticResource CapriButton}" FontSize="11"
                  MinHeight="30" Padding="12,6"/>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
  </Grid>
</Window>