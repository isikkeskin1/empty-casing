<Window x:Class="Capri.Desktop.Windows.NowPlayingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capri // Now Playing" Width="545" Height="435"
        MinWidth="450" MinHeight="400" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CapriBaseBrush}" Foreground="{StaticResource CapriTextBrush}"
        FontFamily="Segoe UI">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="23">
      <TextBlock Text="CAPRI // NOW PLAYING" FontFamily="Bahnschrift SemiCondensed"
                 FontWeight="Bold" FontSize="27" Foreground="{StaticResource CapriYellowBrush}"/>
      <TextBlock Text="Your music, without leaving the desktop."
                 Style="{StaticResource CapriSubtext}" Margin="0,5,0,18"/>
      <Border Style="{StaticResource CapriPanel}" Padding="18" Margin="0,0,0,13"
              BorderBrush="{StaticResource CapriCyanBrush}">
        <StackPanel>
          <TextBlock Text="/// ACTIVE MEDIA SESSION" Style="{StaticResource CapriLabel}"
                     Margin="0,0,0,13"/>
          <TextBlock x:Name="SongText" Text="Looking for an active session..."
                     TextWrapping="Wrap" FontWeight="Bold" FontSize="22"
                     Foreground="{StaticResource CapriTextBrush}"/>
          <TextBlock x:Name="ArtistText" TextWrapping="Wrap" Margin="0,8,0,0"
                     FontSize="14" Foreground="{StaticResource CapriCyanBrush}"/>
          <TextBlock x:Name="SourceText" TextWrapping="Wrap" Margin="0,8,0,0"
                     FontFamily="Consolas" FontSize="11"
                     Foreground="{StaticResource CapriMutedBrush}"/>
          <Border Background="#203B37" HorizontalAlignment="Left"
                  BorderBrush="#376C65" BorderThickness="1" Padding="10,5"
                  Margin="0,15,0,0" CornerRadius="0,5,0,0">
            <TextBlock x:Name="PlaybackText" FontFamily="Consolas" FontSize="11"
                       FontWeight="Bold" Foreground="{StaticResource CapriCyanBrush}"/>
          </Border>
        </StackPanel>
      </Border>
      <WrapPanel Margin="0,1,0,10">
        <Button Content="REFRESH" Click="Refresh_Click"
                Style="{StaticResource CapriButton}" Margin="0,0,8,8"/>
        <Button Content="◀  PREVIOUS" Click="Previous_Click"
                Style="{StaticResource CapriButton}" Margin="0,0,8,8"/>
        <Button Content="PAUSE" Click="Pause_Click"
                Style="{StaticResource CapriButton}" Margin="0,0,8,8"/>
        <Button Content="PLAY" Click="Play_Click"
                Style="{StaticResource CapriPrimaryButton}" Margin="0,0,8,8"/>
        <Button Content="NEXT  ▶" Click="Next_Click"
                Style="{StaticResource CapriButton}" Margin="0,0,8,8"/>
      </WrapPanel>
      <TextBlock x:Name="FeedbackText" Text="Controls require Desktop Actions or Hands-free."
                 TextWrapping="Wrap" Foreground="{StaticResource CapriTextBrush}"
                 Margin="0,0,0,8"/>
      <TextBlock Text="Spotify, browsers and other apps appear here when they publish a Windows media session. Capri only reacts to local music levels if you enable that option in Senses &amp; Control."
                 Style="{StaticResource CapriSubtext}" FontSize="11"/>
    </StackPanel>
  </ScrollViewer>
</Window>