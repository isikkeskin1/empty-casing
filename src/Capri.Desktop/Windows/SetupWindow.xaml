<Window x:Class="Capri.Desktop.Windows.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capri Desktop — Setup" Width="760" Height="760" MinWidth="600" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#0C111C" Foreground="#E6F4FA">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F4F5FC"/>
      <Setter Property="Background" Value="#263044"/>
      <Setter Property="BorderBrush" Value="#596174"/>
      <Setter Property="Padding" Value="13,8"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#151F30"/>
      <Setter Property="Foreground" Value="#FAFBFF"/>
      <Setter Property="CaretBrush" Value="#FF4F95"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="BorderBrush" Value="#53637A"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#151F30"/>
      <Setter Property="Foreground" Value="#FAFBFF"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="BorderBrush" Value="#53637A"/>
    </Style>
  </Window.Resources>
  <Grid Margin="25">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="CAPRI // SETUP" FontFamily="Consolas" FontSize="30"
                 FontWeight="Bold" Foreground="#FF579A"/>
      <TextBlock Text="Choose her brain and voice. Your machine stays in charge."
                 FontFamily="Consolas" FontSize="12" Foreground="#A2C0CF"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border BorderBrush="#365169" BorderThickness="1" Background="#141D2D"
                CornerRadius="8" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="01   CHOOSE HER BRAIN" Foreground="#7FE2EF" FontFamily="Consolas"
                       FontWeight="Bold" Margin="0,0,0,8"/>
            <ComboBox x:Name="ProviderBox" SelectionChanged="Provider_Changed"
                      Background="#1D2940" Foreground="#111725" Padding="8"
                      FontSize="14" Margin="0,0,0,12"/>
            <StackPanel x:Name="LocalPanel">
              <TextBlock Text="Runs privately on your PC. Large model downloads need an Internet connection once."
                         TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#B4C7D7"/>
              <WrapPanel Margin="0,0,0,10">
                <Button Content="DOWNLOAD OLLAMA" Click="DownloadOllama_Click" Margin="0,0,10,5"/>
                <Button x:Name="PullButton" Content="DOWNLOAD LOCAL MODELS"
                        Click="Pull_Click" Margin="0,0,10,5"/>
                <Button x:Name="CancelPullButton" Content="CANCEL" IsEnabled="False"
                        Click="CancelPull_Click" Margin="0,0,0,5"/>
              </WrapPanel>
              <TextBlock Text="CHAT MODEL" Foreground="#92ACBA" FontFamily="Consolas"/>
              <TextBox x:Name="LocalModelBox" Margin="0,4,0,10" Text="qwen3:4b"/>
              <TextBlock Text="SCREEN VISION MODEL" Foreground="#92ACBA" FontFamily="Consolas"/>
              <TextBox x:Name="LocalVisionBox" Margin="0,4,0,0" Text="qwen3-vl:4b"/>
            </StackPanel>
            <StackPanel x:Name="CloudPanel" Visibility="Collapsed">
              <TextBlock Text="Optional online brain. Prompts and approved screenshots go to the selected provider; their terms, pricing and quotas apply."
                         Foreground="#F0B6C7" TextWrapping="Wrap" Margin="0,0,0,10"/>
              <Button Content="OPEN OFFICIAL API KEY PAGE" HorizontalAlignment="Left"
                      Click="GetKey_Click" Margin="0,0,0,8"/>
              <TextBlock Text="PASTE API KEY (ENCRYPTED FOR WINDOWS USER)"
                         Foreground="#92ACBA" FontFamily="Consolas"/>
              <PasswordBox x:Name="CloudKeyBox" Margin="0,5,0,4"/>
              <TextBlock x:Name="SavedKeyText" Foreground="#7EDBC1" FontFamily="Consolas"
                         FontSize="10" Margin="0,0,0,10"/>
              <TextBlock Text="CHAT MODEL ID" Foreground="#92ACBA" FontFamily="Consolas"/>
              <TextBox x:Name="CloudModelBox" Margin="0,4,0,10"/>
              <TextBlock Text="VISION MODEL ID (OPTIONAL — MUST SUPPORT IMAGES)"
                         Foreground="#92ACBA" FontFamily="Consolas"/>
              <TextBox x:Name="CloudVisionBox" Margin="0,4,0,0"/>
              <TextBlock Text="Leave vision model blank to disable cloud screen analysis. Free-tier eligibility differs by provider and model."
                         Foreground="#9CAEC0" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border BorderBrush="#365169" BorderThickness="1" Background="#141D2D"
                CornerRadius="8" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="02   HER VOICE" Foreground="#7FE2EF" FontFamily="Consolas"
                       FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="Use a local Windows voice or opt into cloud Fish Audio. Fish receives the text Capri speaks; usage limits or charges may apply."
                       Foreground="#B4C7D7" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <ComboBox x:Name="VoiceProviderBox" SelectionChanged="VoiceProvider_Changed"
                      Padding="8" Margin="0,0,0,10" Background="#1D2940" Foreground="#111725"/>
            <StackPanel x:Name="WindowsVoicePanel">
              <ComboBox x:Name="VoiceBox" Padding="8" Background="#1D2940" Foreground="#111725"/>
            </StackPanel>
            <StackPanel x:Name="FishVoicePanel" Visibility="Collapsed">
              <Button Content="GET NEW FISH AUDIO API KEY" Click="GetFishKey_Click"
                      HorizontalAlignment="Left" Margin="0,0,0,8"/>
              <TextBlock Text="FISH API KEY (ENCRYPTED WITH WINDOWS DPAPI)"
                         Foreground="#92ACBA" FontFamily="Consolas" FontSize="11"/>
              <PasswordBox x:Name="FishKeyBox" Margin="0,5,0,5"/>
              <TextBlock x:Name="FishSavedKeyText" Foreground="#7EDBC1" FontFamily="Consolas"
                         FontSize="10" Margin="0,0,0,8"/>
              <TextBlock Text="FISH MODEL" Foreground="#92ACBA" FontFamily="Consolas" FontSize="11"/>
              <ComboBox x:Name="FishModelBox" Padding="8" Margin="0,4,0,8"
                        Background="#1D2940" Foreground="#111725"/>
              <TextBlock Text="VOICE REFERENCE ID (OPTIONAL)"
                         Foreground="#92ACBA" FontFamily="Consolas" FontSize="11"/>
              <TextBox x:Name="FishReferenceBox" Margin="0,5,0,8"/>
              <TextBlock Text="Optional reference ID must be a voice you have permission to use. The free model is subject to availability and fair-use limits. Selecting PRO may incur charges."
                         Foreground="#F0B6C7" FontSize="11" TextWrapping="Wrap"/>
              <Button Content="DELETE SAVED FISH KEY" HorizontalAlignment="Left"
                      Margin="0,10,0,0" Click="RemoveFishKey_Click"/>
            </StackPanel>
            <Button x:Name="PreviewVoiceButton" Content="TEST VOICE" Click="PreviewVoice_Click"
                    HorizontalAlignment="Left" Margin="0,12,0,0"/>
            <CheckBox x:Name="SpeakOnCheck" Margin="0,12,0,0"
                      Content="Speak replies aloud after setup"/>
          </StackPanel>
        </Border>

        <Border BorderBrush="#365169" BorderThickness="1" Background="#141D2D"
                CornerRadius="8" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="03   PRIVACY &amp; DESKTOP CONTROL"
                       Foreground="#7FE2EF" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="Screen watching, microphone recognition and desktop actions start OFF. Enable them explicitly in Mainframe when needed. Every desktop action needs approval; purchasing and checkout are disabled. Closing or quitting stops listening and watching."
                       Foreground="#C1D5E0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#161F32" Padding="10" Margin="0,10,0,10">
      <TextBlock x:Name="StatusText" Text="Ready to configure." TextWrapping="Wrap"
                 Foreground="#C0DBE8" FontFamily="Consolas" FontSize="11"/>
    </Border>
    <DockPanel Grid.Row="3">
      <Button Content="CLOSE" DockPanel.Dock="Left" Click="Close_Click" Padding="15,10"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="TestButton" Content="TEST CONNECTION" Click="Test_Click" Margin="0,0,10,0"/>
        <Button x:Name="FinishButton" Content="SAVE &amp; OPEN MAINFRAME" Click="Finish_Click"
                Background="#98315C" BorderBrush="#FF629E" FontWeight="Bold"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
