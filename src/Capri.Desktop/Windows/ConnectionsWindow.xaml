<Window x:Class="Capri.Desktop.Windows.ConnectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capri — Apps &amp; Connections" Width="775" Height="820"
        MinWidth="650" MinHeight="620" Background="{StaticResource CapriBaseBrush}"
        Foreground="#E9F4FA" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource CapriButton}">
      <Setter Property="Background" Value="#29394C"/>
      <Setter Property="Foreground" Value="#ECF8FF"/>
      <Setter Property="BorderBrush" Value="#628096"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="FontFamily" Value="Consolas"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource CapriInput}">
      <Setter Property="Background" Value="#14263A"/>
      <Setter Property="Foreground" Value="#F3F7FC"/>
      <Setter Property="BorderBrush" Value="#587289"/>
      <Setter Property="Padding" Value="9,7"/>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="25">
      <TextBlock Text="CAPRI // APPS &amp; CONNECTIONS" FontFamily="Consolas" FontSize="25"
                 FontWeight="Bold" Foreground="{StaticResource CapriYellowBrush}"/>
      <TextBlock Text="Use your apps immediately on this PC. When Capri has an official provider registration, Connect opens Spotify or Roblox sign-in in your browser. You never paste access tokens or cookies."
                 TextWrapping="Wrap" Foreground="#A3BECA" Margin="0,6,0,16"/>

      <Border Background="#16263A" BorderBrush="#41697B"
              BorderThickness="1" Padding="15" CornerRadius="0,7,0,0">
        <StackPanel>
          <TextBlock Text="SPOTIFY // MUSIC"
                     Foreground="#84E0B6" FontWeight="Bold" FontFamily="Consolas" FontSize="14"/>
          <TextBlock Text="Control Spotify running on your PC without an account link. For track search, queue and full Spotify Web API access, authorize Capri in your browser when the publisher's Spotify app is configured."
                     TextWrapping="Wrap" Foreground="#A9BFCE" FontSize="11"
                     Margin="0,9,0,8"/>
          <WrapPanel>
            <Button x:Name="ConnectSpotifyButton" Content="CONNECT SPOTIFY ACCOUNT"
                    Click="ConnectSpotify_Click" Background="#23624E"/>
            <Button Content="OPEN SPOTIFY ON THIS PC" Click="OpenSpotifyLocal_Click"/>
            <Button Content="UNLINK" Click="UnlinkSpotify_Click"/>
          </WrapPanel>
          <Expander Header="Advanced — developer OAuth setup (optional)"
                    Foreground="#9EBACC" Margin="0,4,0,10">
            <StackPanel Margin="8,8,0,0">
              <TextBlock Text="Only Capri's publisher needs to register an OAuth app. If you're developing your own build, the Spotify app's public client ID and redirect are configured here. Never enter a token or secret."
                         TextWrapping="Wrap" FontSize="11"/>
              <TextBlock Text="Registered redirect: http://127.0.0.1:18441/oauth/spotify/"
                         FontFamily="Consolas" FontSize="10" Margin="0,8,0,4"/>
              <TextBox x:Name="SpotifyIdBox" Margin="0,5,0,9"/>
              <Button Content="SAVE DEVELOPER CLIENT ID" Click="SaveIds_Click"
                      HorizontalAlignment="Left"/>
            </StackPanel>
          </Expander>
          <TextBlock x:Name="SpotifyAccountText" Text="Not linked."
                     Foreground="#CDE4F0" Margin="0,4,0,11" TextWrapping="Wrap"/>
          <WrapPanel>
            <Button Content="ACCOUNT / PLAYBACK" Click="SpotifyStatus_Click"/>
            <Button Content="PLAY" Click="SpotifyPlay_Click"/>
            <Button Content="PAUSE" Click="SpotifyPause_Click"/>
            <Button Content="NEXT" Click="SpotifyNext_Click"/>
            <Button Content="PREVIOUS" Click="SpotifyPrevious_Click"/>
          </WrapPanel>
          <DockPanel Margin="0,7,0,8">
            <Button Content="SEARCH TRACKS" DockPanel.Dock="Right"
                    Click="SpotifySearch_Click" Margin="10,0,0,0"/>
            <TextBox x:Name="TrackQuery" Padding="9,6"/>
          </DockPanel>
          <ListBox x:Name="TrackResults" Height="115"
                   DisplayMemberPath="Display"
                   Background="#0C1B2C" Foreground="#F4F7F9"
                   BorderBrush="#40647E" Padding="5"/>
          <WrapPanel Margin="0,10,0,0">
            <Button Content="PLAY SELECTED SPOTIFY TRACK" Click="SpotifyPlayTrack_Click"
                    Background="#235F4C" BorderBrush="#75BA9D"/>
            <Button Content="QUEUE SELECTED SPOTIFY TRACK" Click="SpotifyQueueTrack_Click"
                    Background="#254D6B" BorderBrush="#75AFD1"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Margin="0,18,0,0" Background="#16263A"
              BorderBrush="#5862A0" BorderThickness="1"
              Padding="15" CornerRadius="0,7,0,0">
        <StackPanel>
          <TextBlock Text="ROBLOX // GAMES &amp; ACCOUNT"
                     Foreground="#B9B4FA" FontWeight="Bold" FontFamily="Consolas" FontSize="14"/>
          <TextBlock Text="Launch Roblox games without providing cookies or tokens. Sign in through Roblox's own browser to authorize Capri profile access when the official OAuth app is configured."
                     TextWrapping="Wrap" Foreground="#A9BFCE" FontSize="11"
                     Margin="0,9,0,8"/>
          <WrapPanel>
            <Button Content="CONNECT ROBLOX ACCOUNT" Click="ConnectRoblox_Click"
                    Background="#514682"/>
            <Button Content="OPEN ROBLOX" Click="OpenRobloxLocal_Click"/>
            <Button Content="UNLINK" Click="UnlinkRoblox_Click"/>
            <Button Content="MY PROFILE" Click="RobloxProfile_Click"/>
          </WrapPanel>
          <Expander Header="Advanced — developer OAuth setup (optional)"
                    Foreground="#A9BFCE" Margin="0,4,0,10">
            <StackPanel Margin="8,8,0,0">
              <TextBlock Text="Only the publisher registers this OAuth client. Developer builds may provide a public client ID with openid + profile permissions. Do not enter a cookie, secret or personal token."
                         TextWrapping="Wrap" FontSize="11"/>
              <TextBlock Text="Registered redirect: http://127.0.0.1:18442/oauth/roblox/"
                         FontFamily="Consolas" FontSize="10" Margin="0,8,0,4"/>
              <TextBox x:Name="RobloxIdBox" Margin="0,5,0,9"/>
              <Button Content="SAVE DEVELOPER CLIENT ID" Click="SaveIds_Click"
                      HorizontalAlignment="Left"/>
            </StackPanel>
          </Expander>
          <TextBlock x:Name="RobloxAccountText" Text="Not linked."
                     Foreground="#D6DAF6" TextWrapping="Wrap"
                     Margin="0,2,0,11"/>
          <DockPanel>
            <Button Content="OPEN ROBLOX EXPERIENCE" DockPanel.Dock="Right"
                    Click="OpenRobloxExperience_Click" Margin="10,0,0,0"/>
            <TextBox x:Name="RobloxPlaceBox" ToolTip="Numeric Roblox place ID"
                     Padding="9,6"/>
          </DockPanel>
          <TextBlock Text="Roblox game launching uses a validated official game-start link. Roblox's newer share links are recommended for creator campaigns. No injected Roblox client or session cookies."
                     TextWrapping="Wrap" Foreground="#91A8C2" FontSize="11"
                     Margin="0,9,0,0"/>
        </StackPanel>
      </Border>
      <TextBlock x:Name="StatusText" Text="Account sign-in is handled by official Spotify/Roblox pages. Capri stores OAuth credentials encrypted for this Windows user. Local app use does not require account linking."
                 TextWrapping="Wrap" Foreground="#B7D5E3" Margin="0,15,0,8"/>
      <Button x:Name="CancelConnectButton" Content="CANCEL CURRENT LOGIN"
              Click="CancelConnect_Click" IsEnabled="False"
              HorizontalAlignment="Left" Background="#793747"/>
    </StackPanel>
  </ScrollViewer>
</Window>