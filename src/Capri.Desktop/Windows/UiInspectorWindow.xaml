<Window x:Class="Capri.Desktop.Windows.UiInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capri — Autonomous Window Control" Width="710" Height="785"
        MinWidth="570" MinHeight="690" WindowStartupLocation="CenterOwner"
        Background="#0C1421" Foreground="#E5F3FC">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#24344B"/>
      <Setter Property="Foreground" Value="#F4F6FA"/>
      <Setter Property="BorderBrush" Value="#577087"/>
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontFamily" Value="Consolas"/>
    </Style>
  </Window.Resources>
  <DockPanel Margin="22">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="CAPRI // WINDOW CONTROLS" Foreground="#FD7FB0"
                 FontWeight="Bold" FontSize="22" FontFamily="Consolas"/>
      <TextBlock Text="Approve one task; Capri navigates real tabs, trees and safe buttons without per-step prompts."
                 Foreground="#A0BACB" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <TextBlock x:Name="StatusText" Foreground="#B9D9E9" FontFamily="Consolas"
                 FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <DockPanel>
        <Button Content="REFRESH WINDOW" DockPanel.Dock="Left" Click="Refresh_Click"/>
        <Button x:Name="SelectButton" Content="APPROVE AND SELECT TAB"
                DockPanel.Dock="Right" HorizontalAlignment="Right"
                Background="#A23561" BorderBrush="#F877A1"
                IsEnabled="False" Click="Select_Click"/>
      </DockPanel>
    </StackPanel>
    <StackPanel>
      <Border Background="#172337" BorderBrush="#3F5872" BorderThickness="1"
              CornerRadius="5" Padding="12" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="TARGET APPLICATION" Foreground="#91B6CA"
                     FontFamily="Consolas" FontSize="11"/>
          <TextBlock x:Name="WindowName" Text="No window inspected."
                     Foreground="#F4F5F8" FontSize="15" FontWeight="SemiBold"
                     TextWrapping="Wrap" Margin="0,6,0,0"/>
          <TextBlock x:Name="WindowDetails" Foreground="#93AFC2"
                     FontFamily="Consolas" FontSize="10" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
      <TextBlock Text="ACCESSIBLE TABS — READ ONLY INSPECTION"
                 Foreground="#7DE2E4" FontFamily="Consolas"
                 FontWeight="Bold" Margin="0,0,0,8"/>
      <ListBox x:Name="TabsList" SelectionChanged="Tab_Changed"
               DisplayMemberPath="Name"
               Background="#111B2A" Foreground="#DCE9F2"
               BorderBrush="#3B5870" BorderThickness="1"
               FontSize="14" Padding="8" MinHeight="180"/>
      <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                 Foreground="#90A9BA" FontSize="11"
                 Text="Selection requires DESKTOP ACTIONS enabled and an additional confirmation. Tabs named for payments, accounts, security or destructive settings are blocked. Targets expire after 20 seconds and are rechecked before execution."/>
      <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                 Foreground="#90A9BA" FontSize="11"
                 Text="Manual inspection stays local. For an AI task, the selected brain receives only the goal, window title and eligible tab names; a cloud provider requires task-level consent."/>
      <Border Margin="0,16,0,0" BorderBrush="#3D6471" BorderThickness="1"
              CornerRadius="6" Background="#15253A" Padding="12">
        <StackPanel>
          <TextBlock Text="AUTONOMOUS NAVIGATION // ONE-TASK PERMISSION"
                     Foreground="#79E4DD" FontWeight="Bold" FontFamily="Consolas"
                     FontSize="12" Margin="0,0,0,9"/>
          <TextBlock Text="Goal (example: find the Display tab)"
                     Foreground="#A6BACC" Margin="0,0,0,5"/>
          <TextBox x:Name="TaskGoalBox" Height="34" Background="#0D1929"
                   BorderBrush="#446177" Foreground="#F1F6FC"
                   Padding="9,6" Text="Find the Display tab"/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
            <Button x:Name="StartTaskButton" Content="APPROVE TASK AND RUN"
                    Click="StartTask_Click" Background="#1D665E"
                    BorderBrush="#62C5BC"/>
            <Button x:Name="StopTaskButton" Content="STOP TASK"
                    Click="StopTask_Click" IsEnabled="False"
                    Background="#803047" BorderBrush="#E16D82"/>
          </StackPanel>
          <TextBlock Text="Up to 5 tab selections, navigation-tree expansions or strictly allowlisted navigation-button activations in 90 seconds. No per-step prompts. STOP TASK cancels. No Save, Send, checkout or typing."
                     TextWrapping="Wrap" Foreground="#9DB7C4" FontSize="11"
                     Margin="0,0,0,9"/>
          <TextBox x:Name="TaskLog" Height="105" IsReadOnly="True"
                   VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                   Background="#0A1423" Foreground="#D2E6F2"
                   BorderBrush="#395166" Padding="7"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </DockPanel>
</Window>
