<Window x:Class="Capri.Desktop.Windows.UiInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capri — Window Controls" Width="690" Height="610"
        MinWidth="540" MinHeight="480" WindowStartupLocation="CenterOwner"
        Background="#0C1421" Foreground="#E5F3FC">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#24344B"/>
      <Setter Property="Foreground" Value="#F4F6FA"/>
      <Setter Property="BorderBrush" Value="#577087"/>
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontFamily" Value="Consolas"/>
    </Style>
  </Window.Resources>
  <DockPanel Margin="22">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="CAPRI // WINDOW CONTROLS" Foreground="#FD7FB0"
                 FontWeight="Bold" FontSize="22" FontFamily="Consolas"/>
      <TextBlock Text="Inspect an app's accessible tabs. No arbitrary clicking, typing or purchases."
                 Foreground="#A0BACB" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <TextBlock x:Name="StatusText" Foreground="#B9D9E9" FontFamily="Consolas"
                 FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <DockPanel>
        <Button Content="REFRESH WINDOW" DockPanel.Dock="Left" Click="Refresh_Click"/>
        <Button x:Name="SelectButton" Content="APPROVE AND SELECT TAB"
                DockPanel.Dock="Right" HorizontalAlignment="Right"
                Background="#A23561" BorderBrush="#F877A1"
                IsEnabled="False" Click="Select_Click"/>
      </DockPanel>
    </StackPanel>
    <StackPanel>
      <Border Background="#172337" BorderBrush="#3F5872" BorderThickness="1"
              CornerRadius="5" Padding="12" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="TARGET APPLICATION" Foreground="#91B6CA"
                     FontFamily="Consolas" FontSize="11"/>
          <TextBlock x:Name="WindowName" Text="No window inspected."
                     Foreground="#F4F5F8" FontSize="15" FontWeight="SemiBold"
                     TextWrapping="Wrap" Margin="0,6,0,0"/>
          <TextBlock x:Name="WindowDetails" Foreground="#93AFC2"
                     FontFamily="Consolas" FontSize="10" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
      <TextBlock Text="ACCESSIBLE TABS — READ ONLY INSPECTION"
                 Foreground="#7DE2E4" FontFamily="Consolas"
                 FontWeight="Bold" Margin="0,0,0,8"/>
      <ListBox x:Name="TabsList" SelectionChanged="Tab_Changed"
               DisplayMemberPath="Name"
               Background="#111B2A" Foreground="#DCE9F2"
               BorderBrush="#3B5870" BorderThickness="1"
               FontSize="14" Padding="8" MinHeight="180"/>
      <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                 Foreground="#90A9BA" FontSize="11"
                 Text="Selection requires DESKTOP ACTIONS enabled and an additional confirmation. Tabs named for payments, accounts, security or destructive settings are blocked. Targets expire after 20 seconds and are rechecked before execution."/>
      <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                 Foreground="#90A9BA" FontSize="11"
                 Text="Nothing in this panel is sent to a cloud AI model. Only accessible tab labels are inspected; form values and passwords are never read."/>
    </StackPanel>
  </DockPanel>
</Window>
